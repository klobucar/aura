<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Aura.Desktop.Converters"
             x:Class="Aura.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Slot 0 is the palette; AuraThemeManager swaps it at runtime. -->
                <ResourceInclude Source="avares://Aura.Desktop/Themes/Zenith.axaml"/>
                <ResourceInclude Source="avares://Aura.Desktop/Themes/AuraTokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Aura.Desktop/Styles/AuraStyles.axaml"/>
    </Application.Styles>
</Application>
