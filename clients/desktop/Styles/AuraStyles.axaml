<!-- Shared control styles built on the design tokens, in the macOS client's
     shape language on every platform: rounded panels and rows, glass capsules
     (Border.capsule, Button.glass) with a light-to-dark rim and soft shadow,
     circular avatars, `white @ 6%` hover with no scale, accent-underlined
     TextBox. Glass has no backdrop blur: Avalonia can only blur behind the
     whole window. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Aura.Desktop.Controls">

    <!-- ========================= Settings rows ========================= -->

    <!-- Label left, switch right, one row per setting. Fluent's own ToggleSwitch
         stacks a larger header above the switch and reserves 154px for
         On/Off text the settings sheet never shows. -->
    <Style Selector="TextBlock.settingLabel">
        <Setter Property="FontSize" Value="{StaticResource AuraFont12}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="ToggleSwitch.settingSwitch">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="OnContent" Value="{x:Null}"/>
        <Setter Property="OffContent" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================ Icons ============================ -->

    <!-- Lucide outlines (Themes/AuraIcons.axaml). 16 is the toolbar size;
         sites that need another size set Width/Height. -->
    <Style Selector="controls|AuraIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- ============================ Type ============================ -->

    <!-- Mono is load-bearing: numerics, fingerprints, keycaps, section labels. -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource AuraMonoFontFamily}"/>
    </Style>
    <Style Selector="SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource AuraMonoFontFamily}"/>
    </Style>

    <!-- `ROSTER · 7 ONLINE`, `LAST 3 MIN`, `SILENT`, `INPUT` -->
    <Style Selector="TextBlock.monoLabel">
        <Setter Property="FontFamily" Value="{StaticResource AuraMonoFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource AuraMono10}"/>
        <Setter Property="LetterSpacing" Value="{StaticResource AuraMonoLabelTracking}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextDimBrush}"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource AuraFont14}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="-0.14"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBrush}"/>
    </Style>

    <!-- ========================== Surfaces ========================== -->

    <!-- Tinted panel: the rail / stage only. Never glass on glass. -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource AuraPanelFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusTile}"/>
    </Style>

    <!-- Modal sheet over the scrim (trust, moderation, settings, profile card,
         channel editor, confirms). Opaque on purpose: the panel fill is a
         5-13% tint, and a sheet filled with it lets the chat behind show
         through its own text and inputs. -->
    <Style Selector="Border.sheet">
        <Setter Property="Background" Value="{DynamicResource AuraBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusTile}"/>
    </Style>

    <!-- The dimmed layer behind a sheet. Opening fades the scrim in, then the
         sheet a beat behind it; a style animation runs each time its selector
         starts matching, so it replays on every open. -->
    <Style Selector="Border.scrim">
        <Setter Property="Background" Value="#99000000"/>
    </Style>
    <Style Selector="Border.scrim[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.14" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.scrim[IsVisible=True] > Border.sheet">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Glass capsule (macOS auraGlass): panel fill, a rim that is light on
         top and dark underneath, and a soft drop shadow. The composer, the
         voice card and the Settings button. No backdrop blur: Avalonia can
         only blur behind the whole window. -->
    <Style Selector="Border.capsule">
        <Setter Property="Background" Value="{DynamicResource AuraPanelFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraGlassRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusCapsule}"/>
        <Setter Property="BoxShadow" Value="0 8 15 0 #26000000"/>
    </Style>

    <!-- Inset well for segmented controls and meters -->
    <Style Selector="Border.well">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusControl}"/>
    </Style>

    <!-- Mono badge / pill -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusBadge}"/>
        <Setter Property="Padding" Value="7,2"/>
    </Style>

    <!-- ============================ Rows ============================ -->

    <!-- Channel / member / silent rows. Hover is a white @ 6% overlay with no
         scale — the desktop translation of macOS's auraFluidHover. -->
    <!-- Every button eases its fill and rim instead of snapping on hover and
         press. Classes that set their own Transitions (Button.row) win. -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.row">
        <Setter Property="Background" Value="Transparent"/>
        <!-- A transparent 1px rim, so the current row's rim doesn't shift content. -->
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusTile}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.row /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraHoverOverlayBrush}"/>
    </Style>
    <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraHoverOverlayBrush}"/>
    </Style>

    <!-- A row that can't be clicked stays flat; Fluent's disabled fill would
         paint it as a grey slab. -->
    <Style Selector="Button.row:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- The channel you're in: primary @ 20% with a primary @ 32% rim, the
         macOS client's selected row, held through hover and press. -->
    <Style Selector="Button.row.current">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBorderBrush}"/>
    </Style>
    <Style Selector="Button.row.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBorderBrush}"/>
    </Style>
    <Style Selector="Button.row.current:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraPrimaryTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPrimaryBorderBrush}"/>
    </Style>

    <!-- Full-width glass button (the sidebar's Settings), macOS auraGlass at r18.
         Icon and label take the button's foreground. -->
    <Style Selector="Button.glass">
        <Setter Property="Background" Value="{DynamicResource AuraPanelFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraGlassRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusCard}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextMidBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraGlassRimBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBrush}"/>
    </Style>
    <Style Selector="Button.glass:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraGlassRimBrush}"/>
    </Style>

    <!-- Flat icon button (header toggles, HUD segments, attach) -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusControl}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextDimBrush}"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraHoverOverlayBrush}"/>
    </Style>

    <!-- Brand-gradient action (send, save). Fluent swaps a button's background
         for its own grey on hover and press, which drops the gradient from
         under the white label; keep it. -->
    <Style Selector="Button.brand">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.brand:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.brand:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Destructive and cautionary actions, held through hover and press for
         the same reason as Button.brand. `danger` is the tinted form (Block,
         Ban, Leave server); `dangerSolid` is the final confirm; `caution` is
         amber with dark text in both variants. -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource AuraDangerFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraDangerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraDangerBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraDangerFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraDangerBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraDangerBrush}"/>
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraDangerFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraDangerBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraDangerBrush}"/>
    </Style>
    <Style Selector="Button.dangerSolid">
        <Setter Property="Background" Value="{DynamicResource AuraDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraDangerBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.dangerSolid:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraDangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.dangerSolid:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraDangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.caution">
        <Setter Property="Background" Value="{DynamicResource AuraCautionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraCautionBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#12141A"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.caution:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraCautionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraCautionBrush}"/>
        <Setter Property="Foreground" Value="#12141A"/>
    </Style>
    <Style Selector="Button.caution:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraCautionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraCautionBrush}"/>
        <Setter Property="Foreground" Value="#12141A"/>
    </Style>

    <!-- ===================== Command HUD segments ==================== -->

    <!-- Mic / deafen pair. The active segment is 42×34 on the brand gradient;
         inactive is a textDim glyph on nothing. macOS glows here; on desktop the
         gradient fill alone carries the state. -->
    <Style Selector="ToggleButton.hudSegment">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusControl}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.hudSegment /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusControl}"/>
    </Style>
    <Style Selector="ToggleButton.hudSegment:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
    </Style>
    <Style Selector="ToggleButton.hudSegment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraHoverOverlayBrush}"/>
    </Style>
    <Style Selector="ToggleButton.hudSegment:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
    </Style>

    <!-- The same segment as a plain Button whose `on` class follows the view
         model, so the state can never be flipped by the control itself. -->
    <Style Selector="Button.hudSegment">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusPill}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.hudSegment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraHoverOverlayBrush}"/>
    </Style>
    <Style Selector="Button.hudSegment.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
    </Style>

    <!-- ========================= Text input ========================= -->

    <!-- Mapping table: TextBox with a 2px accent underline on focus. -->
    <Style Selector="TextBox.aura">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusControl}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource AuraFont13}"/>
        <Setter Property="Padding" Value="10,9"/>
    </Style>
    <Style Selector="TextBox.aura /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- Fluent swaps the fill on hover and focus (TextControlBackgroundFocused is
         black in dark mode); the well stays put and the underline shows focus. -->
    <Style Selector="TextBox.aura:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
    </Style>
    <Style Selector="TextBox.aura:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraAccentBrush}"/>
    </Style>

    <!-- A field inside a capsule: no fill, rim or underline of its own, in any
         state; the capsule around it is the control. -->
    <Style Selector="TextBox.bare">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource AuraFont13}"/>
        <Setter Property="Padding" Value="4,8"/>
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Round send button: a quiet well until there is something to send, then
         the brand gradient with a shadow, as macOS's paperplane button. -->
    <Style Selector="Button.send">
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusPill}"/>
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextDimBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBrush}"/>
    </Style>
    <Style Selector="Button.send.ready">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.send.ready /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 3 8 0 #40000000"/>
    </Style>
    <Style Selector="Button.send.ready:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.send.ready:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraBrandGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ComboBox to match TextBox.aura: the same well, radius and type size,
         no rim. Without this it is the stock Fluent box, with a bright border
         and 14px text beside a 13px borderless input. -->
    <Style Selector="ComboBox.aura">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusControl}"/>
        <Setter Property="FontSize" Value="{StaticResource AuraFont13}"/>
    </Style>
    <Style Selector="ComboBox.aura:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.aura:pressed /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- ========================= Animations ========================= -->

    <!-- Speaking ring: 1.4s ease-in-out, opacity 0.35 -> 0.85, scale 1 -> 1.05 -->
    <Style Selector="Border.pulseRing">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.85"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1.05"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.05"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Mode swap: only the column widths move (cubic ease-out 300ms). -->
    <Style Selector="Border.modeColumn">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Content that only exists in one mode cross-fades over 160ms. -->
    <Style Selector=":is(Control).modeFade">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                <DoubleTransition Property="Width" Duration="0:0:0.16"/>
                <DoubleTransition Property="Height" Duration="0:0:0.16"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Filter chip (moderation console): a pill that fills when it is the active filter. -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusPill}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource AuraTextDimBrush}"/>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraHoverOverlayBrush}"/>
    </Style>
    <Style Selector="Button.chip.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AuraWellBrush}"/>
    </Style>
    <Style Selector="Button.chip.on">
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBrush}"/>
    </Style>

</Styles>
