<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aura.Desktop.ViewModels"
        xmlns:converters="using:Aura.Desktop.Converters"
        xmlns:controls="using:Aura.Desktop.Controls"
        xmlns:svc="using:Aura.Desktop.Services"
        x:Class="Aura.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/aura.ico"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur"
        Background="{DynamicResource AuraBackgroundBrush}">

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>

    <Window.KeyBindings>
        <!-- Mode swap: Ctrl+Alt+V (⌘⌥V on macOS) -->
        <KeyBinding Gesture="Ctrl+Alt+V" Command="{Binding ToggleLayoutModeCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- Window material. Acrylic carries the depth so the panes can be flat:
             one translucent layer per depth level, never glass on glass. The tint
             is set from the palette in code-behind. -->
        <ExperimentalAcrylicBorder x:Name="AcrylicRoot" IsHitTestVisible="False"/>

        <!-- ============================================================
             Three columns: roster 268 · chat flex · voice rail 336.
             In voice-focus the rail takes the slack and chat lands on 320;
             only VoiceColumnWidth animates (cubic ease-out 300ms).
             ============================================================ -->
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- ========================================================
                 ROSTER — identical in both modes. Every channel, expanded,
                 with its occupants, including channels you are not in.
                 ======================================================== -->
            <Border Grid.Column="0"
                    Width="{Binding RosterWidth}"
                    Background="{DynamicResource AuraSidebarOverlayBrush}"
                    BorderBrush="{DynamicResource AuraDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="10,0,10,12">

                    <!-- ── Title row ── -->
                    <Grid Grid.Row="0" Height="52">
                        <TextBlock Text="Aura"
                                   Classes="title"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ── Identity card ── -->
                    <Border Grid.Row="1" Classes="panel" Padding="12,10" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Rounded-square avatar (desktop idiom), brand gradient -->
                            <Border Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0"
                                    CornerRadius="{StaticResource AuraRadiusAvatar}"
                                    ClipToBounds="True"
                                    Background="{DynamicResource AuraBrandGradientBrush}">
                                <Panel>
                                    <TextBlock Text="{Binding OwnInitial}"
                                               IsVisible="{Binding ShowMyInitial}"
                                               FontSize="{StaticResource AuraFont14}"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Image Source="{Binding MyAvatarImage}"
                                           IsVisible="{Binding HasMyAvatar}"
                                           Stretch="UniformToFill"/>
                                </Panel>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="{StaticResource AuraFont13}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- `verified · 3f8a…5503` — mono is machine truth -->
                                <TextBlock Classes="mono"
                                           Text="{Binding FingerprintDisplay}"
                                           FontSize="{StaticResource AuraMono9}"
                                           Foreground="{DynamicResource AuraAccentBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Classes="icon"
                                    IsVisible="{Binding IsConnected}"
                                    ToolTip.Tip="Connection">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}"/>
                                        <MenuItem Header="Leave server…" Command="{Binding AskLeaveServerCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <TextBlock Text="⋯" FontSize="{StaticResource AuraFont13}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── QUIC unavailable ──
                         Danger, not caution: this is not a risk to weigh, it is
                         the app being unable to run here. The remedy differs per
                         platform (a missing package on Linux, an OS floor on
                         Windows), so it is carried in the text rather than
                         implied. -->
                    <StackPanel Grid.Row="2">
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            CornerRadius="{StaticResource AuraRadiusTile}"
                            Background="{DynamicResource AuraDangerFillBrush}"
                            BorderBrush="{DynamicResource AuraDangerBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding ShowQuicUnavailable}">
                        <StackPanel Spacing="{StaticResource AuraSpace9}">
                            <TextBlock Text="{Binding QuicUnavailableHeadline}"
                                       FontSize="{StaticResource AuraFont13}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraDangerBrush}"
                                       TextWrapping="Wrap"/>
                            <SelectableTextBlock Text="{Binding QuicUnavailableRemedy}"
                                                 FontSize="{StaticResource AuraFont11}"
                                                 Foreground="{DynamicResource AuraTextDimBrush}"
                                                 TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Certificate warning (untrusted server key) ── -->
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            CornerRadius="{StaticResource AuraRadiusTile}"
                            Background="{DynamicResource AuraCautionFillBrush}"
                            BorderBrush="{DynamicResource AuraCautionBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding ShowingCertWarning}">
                        <StackPanel Spacing="{StaticResource AuraSpace9}">
                            <TextBlock Text="Untrusted certificate"
                                       FontSize="{StaticResource AuraFont13}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraCautionTextBrush}"/>
                            <TextBlock Text="The server is using an unknown identity. Check the fingerprint below:"
                                       FontSize="{StaticResource AuraFont11}"
                                       Foreground="{DynamicResource AuraTextDimBrush}"
                                       TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource AuraWellBrush}"
                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                    Padding="8">
                                <SelectableTextBlock Classes="mono"
                                                     Text="{Binding CertFingerprint}"
                                                     FontSize="{StaticResource AuraMono10}"
                                                     Foreground="{DynamicResource AuraTextMidBrush}"
                                                     TextWrapping="Wrap"/>
                            </Border>
                            <Button Classes="caution" Command="{Binding TrustAndConnectCommand}"
                                    Background="{DynamicResource AuraCautionBrush}"
                                    Foreground="#12141A"
                                    FontWeight="SemiBold"
                                    FontSize="{StaticResource AuraFont12}"
                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                    Padding="0,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Content="They match — trust and connect"/>
                            <Button Command="{Binding DismissCertWarningCommand}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource AuraPanelBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource AuraTextBrush}"
                                    FontSize="{StaticResource AuraFont12}"
                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                    Padding="0,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Content="Cancel"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- ── Channels + occupants, or the connection form ── -->
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="{StaticResource AuraSpace8}">

                            <!-- Connection form (disconnected only) -->
                            <StackPanel Spacing="{StaticResource AuraSpace8}">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsConnected" Converter="{StaticResource InverseBoolConverter}"/>
                                        <Binding Path="ShowingCertWarning" Converter="{StaticResource InverseBoolConverter}"/>
                                    </MultiBinding>
                                </StackPanel.IsVisible>

                                <TextBlock Classes="monoLabel" Text="CONNECTION" Margin="8,6,0,2"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Classes="aura"
                                             Text="{Binding ServerAddress}"
                                             PlaceholderText="Server"/>
                                    <TextBox Grid.Column="1" Classes="aura"
                                             Text="{Binding ServerPort}"
                                             PlaceholderText="Port"
                                             Width="72" Margin="6,0,0,0"/>
                                </Grid>

                                <TextBox Classes="aura"
                                         Text="{Binding ServerPassword}"
                                         PlaceholderText="Password (optional)"
                                         PasswordChar="•"/>

                                <TextBox Classes="aura"
                                         Text="{Binding DisplayName}"
                                         PlaceholderText="Display Name"/>

                                <Button Classes="brand" Command="{Binding ConnectCommand}"
                                        Background="{DynamicResource AuraBrandGradientBrush}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        FontSize="{StaticResource AuraFont13}"
                                        CornerRadius="{StaticResource AuraRadiusControl}"
                                        Padding="0,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Content="Connect"/>

                                <Button Classes="row"
                                        Command="{Binding PasteInviteCommand}"
                                        HorizontalContentAlignment="Center"
                                        ToolTip.Tip="Fill this in from an aura:// invite link on the clipboard">
                                    <TextBlock Text="Paste invite link"
                                               FontSize="{StaticResource AuraFont12}"
                                               Foreground="{DynamicResource AuraLinkBrush}"/>
                                </Button>

                                <!-- Save current server as a bookmark -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                                    <TextBox Grid.Column="0" Classes="aura"
                                             Text="{Binding BookmarkName}"
                                             PlaceholderText="Bookmark name (optional)"/>
                                    <Button Grid.Column="1" Classes="icon"
                                            Command="{Binding SaveCurrentServerCommand}"
                                            Padding="10,6"
                                            ToolTip.Tip="Save server to bookmarks">
                                        <TextBlock Text="Save" FontSize="{StaticResource AuraFont12}"
                                                   Foreground="{DynamicResource AuraLinkBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Saved servers quick-pick -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasSavedServers}" Margin="0,4,0,0">
                                    <TextBlock Classes="monoLabel" Text="SAVED SERVERS" Margin="8,4,0,2"/>
                                    <ItemsControl ItemsSource="{Binding SavedServers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:ServerBookmark">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                    <Button Grid.Column="0" Classes="row"
                                                            Padding="8,6"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectSavedServerCommand}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="{StaticResource AuraFont12}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AuraTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Classes="mono"
                                                                       Text="{Binding AddressLabel}"
                                                                       FontSize="{StaticResource AuraMono9}"
                                                                       Foreground="{DynamicResource AuraTextFaintBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Classes="icon"
                                                            Padding="6,4"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveSavedServerCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Remove saved server">
                                                        <TextBlock Text="×" FontSize="{StaticResource AuraFont13}"
                                                                   Foreground="{DynamicResource AuraTextDimBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- `ROSTER · 7 ONLINE`, + for admins -->
                            <Grid ColumnDefinitions="*,Auto" Margin="8,6,0,2" IsVisible="{Binding IsConnected}">
                                <TextBlock Grid.Column="0" Classes="monoLabel"
                                           Text="{Binding RosterLabel}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsAdmin}">
                                    <Button Classes="icon"
                                            Padding="6,0"
                                            Command="{Binding OpenModerationCommand}"
                                            ToolTip.Tip="Moderate server members">
                                        <TextBlock Text="MODERATE" Classes="monoLabel"/>
                                    </Button>
                                    <Button Classes="icon"
                                            Padding="6,0"
                                            Command="{Binding NewChannelCommand}"
                                            ToolTip.Tip="Create channel">
                                        <TextBlock Text="+" FontSize="{StaticResource AuraFont14}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:Channel">
                                        <StackPanel Margin="0,0,0,2">

                                            <!-- Channel row. Current channel gets a 3px
                                                 accent bar + subtle fill, the Fluent
                                                 NavigationView idiom, not a tinted capsule. -->
                                            <Button Classes="row"
                                                    Padding="0"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).JoinChannelCommand}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu IsVisible="{Binding CanManage}">
                                                        <MenuItem Header="Edit channel…" Command="{Binding EditCommand}"/>
                                                        <MenuItem Header="Delete channel…" Command="{Binding DeleteCommand}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Grid ColumnDefinitions="3,Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="3"
                                                            CornerRadius="{StaticResource AuraRadiusBadge}"
                                                            Background="{DynamicResource AuraAccentBrush}"
                                                            Margin="0,2"
                                                            IsVisible="{Binding IsCurrent}"/>

                                                    <TextBlock Grid.Column="1" Text="{Binding Icon}"
                                                               FontSize="{StaticResource AuraFont13}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,8,0"/>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,7">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="{StaticResource AuraFont13}"
                                                                   FontWeight="{Binding IsCurrent, Converter={x:Static converters:CurrentChannelWeightConverter.Instance}}"
                                                                   Foreground="{DynamicResource AuraTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CommentPreview}"
                                                                   FontSize="{StaticResource AuraFont11}"
                                                                   Foreground="{DynamicResource AuraTextFaintBrush}"
                                                                   IsVisible="{Binding HasComment}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Occupancy pill -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Border Classes="badge"
                                                                Background="{DynamicResource AuraWellBrush}"
                                                                IsVisible="{Binding HasOccupants}">
                                                            <TextBlock Classes="mono"
                                                                       Text="{Binding Users.Count}"
                                                                       FontSize="{StaticResource AuraMono9}"
                                                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!-- Occupants. Always expanded — this is the
                                                 Mumble affordance and must not be traded away. -->
                                            <ItemsControl ItemsSource="{Binding Users}" Margin="0,0,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:User">
                                                        <Button Classes="row"
                                                                Margin="12,1,0,1"
                                                                Padding="0"
                                                                CornerRadius="{StaticResource AuraRadiusControl}"
                                                                Command="{Binding OpenProfileCommand}"
                                                                ToolTip.Tip="{Binding Name}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu IsVisible="{Binding CanAdjust}">
                                                                <MenuItem Header="{Binding LocalMuteLabel}" Command="{Binding ToggleLocalMuteCommand}"/>
                                                                <MenuItem Header="Volume">
                                                                    <MenuItem Header="0%" Command="{Binding SetVolumeCommand}" CommandParameter="0"/>
                                                                    <MenuItem Header="25%" Command="{Binding SetVolumeCommand}" CommandParameter="25"/>
                                                                    <MenuItem Header="50%" Command="{Binding SetVolumeCommand}" CommandParameter="50"/>
                                                                    <MenuItem Header="75%" Command="{Binding SetVolumeCommand}" CommandParameter="75"/>
                                                                    <MenuItem Header="100%" Command="{Binding SetVolumeCommand}" CommandParameter="100"/>
                                                                    <MenuItem Header="125%" Command="{Binding SetVolumeCommand}" CommandParameter="125"/>
                                                                    <MenuItem Header="150%" Command="{Binding SetVolumeCommand}" CommandParameter="150"/>
                                                                    <MenuItem Header="200%" Command="{Binding SetVolumeCommand}" CommandParameter="200"/>
                                                                </MenuItem>
                                                                <MenuItem Header="Profile…" Command="{Binding OpenProfileCommand}"/>
                                                                <Separator IsVisible="{Binding CanModerate}"/>
                                                                <MenuItem Header="{Binding ServerMuteLabel}" Command="{Binding ServerMuteCommand}" IsVisible="{Binding CanModerate}"/>
                                                                <MenuItem Header="Moderate…" Command="{Binding ModerateCommand}" IsVisible="{Binding CanModerate}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Border CornerRadius="{StaticResource AuraRadiusControl}"
                                                                Padding="8,3"
                                                                Background="{Binding IsSpeaking, Converter={x:Static converters:SpeakingRowBrushConverter.Instance}}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <!-- 20px rounded square, 4px radius. Always the brand
                                                                     gradient, as on macOS and every other avatar here;
                                                                     speaking is the row fill, the name colour and the dot. -->
                                                                <Border Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0"
                                                                        CornerRadius="{StaticResource AuraRadiusAvatarSmall}"
                                                                        ClipToBounds="True"
                                                                        Background="{DynamicResource AuraBrandGradientBrush}">
                                                                    <Panel>
                                                                        <TextBlock Text="{Binding Initial}"
                                                                                   IsVisible="{Binding ShowInitial}"
                                                                                   FontSize="{StaticResource AuraMono9}"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                        <Image Source="{Binding Avatar}"
                                                                               IsVisible="{Binding HasAvatar}"
                                                                               Stretch="UniformToFill"/>
                                                                    </Panel>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                    <!-- A Grid, not a horizontal StackPanel: the
                                                                         name only trims when its width is bounded. -->
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                                                        <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                                                                 Fill="{Binding Presence, Converter={x:Static converters:PresenceBrushConverter.Instance}}"
                                                                                 ToolTip.Tip="{Binding PresenceTooltip}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                                   FontSize="{StaticResource AuraFont12}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{Binding IsSpeaking, Converter={StaticResource StatusToBrushConverter}}"/>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding CustomStatus}"
                                                                               IsVisible="{Binding HasCustomStatus}"
                                                                               FontSize="{StaticResource AuraFont11}"
                                                                               Foreground="{DynamicResource AuraTextFaintBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                            Spacing="{StaticResource AuraSpace5}"
                                                                            VerticalAlignment="Center">
                                                                    <!-- server-muted badge -->
                                                                    <Border Classes="badge"
                                                                            Background="{DynamicResource AuraDangerBrush}"
                                                                            IsVisible="{Binding IsServerMuted}"
                                                                            ToolTip.Tip="Server muted by an administrator">
                                                                        <TextBlock Classes="mono" Text="S-MUTED"
                                                                                   FontSize="{StaticResource AuraMono9}"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White"/>
                                                                    </Border>
                                                                    <!-- speaking dot -->
                                                                    <Ellipse Width="6" Height="6"
                                                                             Fill="{DynamicResource AuraAccentBrush}"
                                                                             IsVisible="{Binding IsSpeaking}"/>
                                                                    <!-- muted for me only -->
                                                                    <TextBlock Text="🔇"
                                                                               FontSize="{StaticResource AuraMono9}"
                                                                               Foreground="{DynamicResource AuraWarnBrush}"
                                                                               IsVisible="{Binding IsLocallyMuted}"
                                                                               ToolTip.Tip="Muted locally"/>
                                                                    <!-- mic.slash.fill in warn (deafened implies muted) -->
                                                                    <TextBlock Text="🎙"
                                                                               FontSize="{StaticResource AuraMono9}"
                                                                               Foreground="{DynamicResource AuraWarnBrush}"
                                                                               IsVisible="{Binding ShowMuted}"
                                                                               ToolTip.Tip="Muted"/>
                                                                    <!-- key.fill in caution: key changed since first seen -->
                                                                    <TextBlock Text="🔑"
                                                                               FontSize="{StaticResource AuraMono9}"
                                                                               Foreground="{DynamicResource AuraCautionBrush}"
                                                                               IsVisible="{Binding NeedsKeyCheck}"
                                                                               ToolTip.Tip="Key changed — verify"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Connection status + Settings, bottom-pinned ── -->
                    <StackPanel Grid.Row="5" Spacing="{StaticResource AuraSpace5}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace5}" Margin="8,0">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                            <TextBlock Classes="mono"
                                       Text="{Binding ConnectionStatus}"
                                       FontSize="{StaticResource AuraMono9}"
                                       Foreground="{DynamicResource AuraTextFaintBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="216"
                                       ToolTip.Tip="{Binding ConnectionStatus}"/>
                        </StackPanel>

                        <Button Classes="row"
                                Command="{Binding ToggleSettingsCommand}"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Settings (Ctrl+, / Cmd+,)">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}">
                                <TextBlock Text="⚙" FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                                <TextBlock Text="Settings" FontSize="{StaticResource AuraFont12}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================
                 CHAT — the work surface in chat-first mode.
                 ======================================================== -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                <!-- ── Channel header ── -->
                <Border Grid.Row="0" Height="46"
                        Background="{DynamicResource AuraChromeOverlayBrush}"
                        BorderBrush="{DynamicResource AuraDividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedChannel.Icon, FallbackValue='🔊'}"
                                   FontSize="{StaticResource AuraFont14}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <!-- Name + badge share the flexible column. The badge is
                             docked first so it keeps its width and the name, which
                             fills what is left, is the one that trims. -->
                        <DockPanel Grid.Column="1" HorizontalAlignment="Left">
                        <!-- `E2EE · epoch 14`. The badge that claims the channel
                             is encrypted is also the way to check the claim. -->
                        <Button DockPanel.Dock="Right" Classes="icon"
                                Padding="0"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding OpenTrustSheetCommand}"
                                ToolTip.Tip="Verify who you are talking to"
                                IsVisible="{Binding HasEpoch}">
                            <Border Classes="badge"
                                    Background="{DynamicResource AuraAccentPillFillBrush}"
                                    BorderBrush="{DynamicResource AuraAccentPillBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Classes="mono"
                                           Text="{Binding EpochLabel}"
                                           FontSize="{StaticResource AuraMono10}"
                                           Foreground="{DynamicResource AuraAccentBrush}"/>
                            </Border>
                        </Button>

                        <TextBlock Classes="title"
                                   Text="{Binding SelectedChannel.Name, FallbackValue='No channel'}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SelectedChannel.Name}"
                                   VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- `12 messages today` -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    Spacing="{StaticResource AuraSpace8}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Classes="mono"
                                       Text="{Binding MessagesTodayLabel}"
                                       FontSize="{StaticResource AuraMono10}"
                                       Foreground="{DynamicResource AuraTextDimBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Invite: a link that opens this server (and channel) -->
                            <Button Classes="icon"
                                    Command="{Binding OpenInviteCommand}"
                                    IsVisible="{Binding IsAuthenticated}"
                                    ToolTip.Tip="Invite someone">
                                <TextBlock Text="Invite" FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraLinkBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Width="380" Spacing="{StaticResource AuraSpace9}">
                                            <TextBlock Classes="monoLabel" Text="INVITE LINK"/>
                                            <TextBox Classes="aura" IsReadOnly="True" TextWrapping="Wrap"
                                                     FontFamily="{StaticResource AuraMonoFontFamily}"
                                                     FontSize="{StaticResource AuraMono11}"
                                                     Text="{Binding InviteLink, Mode=OneWay}"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding InviteStatus}"
                                                           FontSize="{StaticResource AuraMono10}"
                                                           Foreground="{DynamicResource AuraAccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Classes="brand" Grid.Column="1" Content="Copy"
                                                        Command="{Binding CopyInviteCommand}"
                                                        Background="{DynamicResource AuraBrandGradientBrush}"
                                                        Foreground="White"
                                                        CornerRadius="{StaticResource AuraRadiusControl}"
                                                        Padding="14,6"/>
                                            </Grid>
                                            <ToggleSwitch IsChecked="{Binding InviteIncludeChannel}"
                                                          Content="{Binding InviteChannelLabel}"
                                                          OnContent="" OffContent=""/>
                                            <StackPanel Spacing="{StaticResource AuraSpace3}">
                                                <ToggleSwitch IsChecked="{Binding InviteIncludePassword}"
                                                              IsEnabled="{Binding CanIncludeInvitePassword}"
                                                              Content="Include the server password"
                                                              OnContent="" OffContent=""/>
                                                <TextBlock Text="Anyone holding the link can then get in"
                                                           FontSize="{StaticResource AuraFont11}"
                                                           Foreground="{DynamicResource AuraCautionTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock IsVisible="{Binding InviteHasFingerprint}"
                                                       Text="The link carries the server's certificate fingerprint, so a friend's first connection is checked against it instead of trusted on sight."
                                                       FontSize="{StaticResource AuraFont11}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- Mode toggle -->
                        <Button Grid.Column="3" Classes="icon"
                                Command="{Binding ToggleLayoutModeCommand}"
                                ToolTip.Tip="{Binding LayoutToggleTip}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding LayoutToggleGlyph}"
                                       FontSize="{StaticResource AuraFont14}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Banner: server mute + connection loss / failures ── -->
                <StackPanel Grid.Row="1" Margin="20,12,20,0" Spacing="8">
                    <Border Padding="12,9"
                            CornerRadius="{StaticResource AuraRadiusTile}"
                            BorderThickness="1"
                            Background="{DynamicResource AuraDangerBrush}"
                            BorderBrush="{DynamicResource AuraDangerBrush}"
                            IsVisible="{Binding IsServerMuted}">
                        <TextBlock Text="🔇 You are server-muted by an administrator. Other members cannot hear you."
                                   FontSize="{StaticResource AuraFont12}"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Border Padding="12,9"
                            CornerRadius="{StaticResource AuraRadiusTile}"
                            BorderThickness="1"
                            Background="{Binding BannerIsError, Converter={x:Static converters:BannerBrushConverter.Fill}}"
                            BorderBrush="{Binding BannerIsError, Converter={x:Static converters:BannerBrushConverter.Border}}"
                            IsVisible="{Binding HasBanner}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <SelectableTextBlock Grid.Column="0"
                                             Text="{Binding BannerText}"
                                             FontSize="{StaticResource AuraFont12}"
                                             Foreground="{Binding BannerIsError, Converter={x:Static converters:BannerBrushConverter.Text}}"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0"
                                Content="Retry now"
                                FontSize="{StaticResource AuraFont12}"
                                Command="{Binding RetryNowCommand}"
                                IsVisible="{Binding IsReconnecting}"/>
                        <Button Grid.Column="2" Classes="icon"
                                Content="Cancel"
                                FontSize="{StaticResource AuraFont12}"
                                Command="{Binding CancelReconnectCommand}"
                                IsVisible="{Binding IsReconnecting}"/>
                        <Button Grid.Column="3" Classes="icon"
                                Content="✕"
                                FontSize="{StaticResource AuraFont12}"
                                Command="{Binding DismissBannerCommand}"
                                IsVisible="{Binding !IsReconnecting}"
                                ToolTip.Tip="Dismiss"/>
                    </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Channel comment / MOTD card (§6), pinned above chat ── -->
                <Border Grid.Row="2"
                        Classes="panel"
                        Margin="20,12,20,0"
                        Padding="0"
                        MaxHeight="150"
                        IsVisible="{Binding HasChannelMotd}">
                    <Grid ColumnDefinitions="3,*">
                        <Border Grid.Column="0"
                                CornerRadius="8,0,0,8"
                                Background="{DynamicResource AuraAccentBrush}"/>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,10" Spacing="{StaticResource AuraSpace5}">
                                <TextBlock Text="{Binding ChannelMotdTitle}"
                                           FontSize="{StaticResource AuraFont13}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraTextBrush}"/>
                                <controls:MarkdownView Markdown="{Binding ChannelMotd}"
                                                       TextSize="{StaticResource AuraFont12}"
                                                       TextBrush="{DynamicResource AuraTextMidBrush}"
                                                       LinkBrush="{DynamicResource AuraLinkBrush}"
                                                       AccentBrush="{DynamicResource AuraAccentBrush}"
                                                       CodeBackground="{DynamicResource AuraWellBrush}"
                                                       CodeFontFamily="{StaticResource AuraMonoFontFamily}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ── Messages ── -->
                <Panel Grid.Row="3">

                <!-- Empty state. The column is otherwise a full-height void with
                     the composer stranded at the bottom, and it is the first
                     thing every new user sees. -->
                <Border IsVisible="{Binding ShowChatEmptyState}"
                        Classes="panel"
                        Padding="20,16"
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="{StaticResource AuraSpace8}">
                        <TextBlock Text="No messages yet"
                                   FontSize="{StaticResource AuraFont13}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AuraTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Messages here are end-to-end encrypted. Your server relays ciphertext only."
                                   FontSize="{StaticResource AuraFont12}"
                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ChatScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,20,20,8">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessage">
                                <!-- Incoming: avatar left. Outgoing: row-reverse, avatar right. -->
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">

                                    <Border Grid.Column="0" Height="34"
                                            Width="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MessageAvatarWidth}"
                                            Margin="0,0,11,0"
                                            VerticalAlignment="Top"
                                            CornerRadius="{StaticResource AuraRadiusAvatar}"
                                            ClipToBounds="True"
                                            Background="{DynamicResource AuraBrandGradientBrush}"
                                            IsVisible="{Binding IsIncoming}">
                                        <Panel>
                                            <TextBlock Text="{Binding Initial}"
                                                       IsVisible="{Binding ShowInitial}"
                                                       FontSize="{StaticResource AuraFont13}"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image Source="{Binding Avatar}"
                                                   IsVisible="{Binding HasAvatar}"
                                                   Stretch="UniformToFill"/>
                                        </Panel>
                                    </Border>

                                    <Border Grid.Column="2" Height="34"
                                            Width="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MessageAvatarWidth}"
                                            Margin="11,0,0,0"
                                            VerticalAlignment="Top"
                                            CornerRadius="{StaticResource AuraRadiusAvatar}"
                                            ClipToBounds="True"
                                            Background="{DynamicResource AuraBrandGradientBrush}"
                                            IsVisible="{Binding IsFromCurrentUser}">
                                        <!-- Our own avatar is the view model's, so every
                                             message of ours follows a change at once. -->
                                        <Panel>
                                            <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OwnInitial}"
                                                       IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ShowMyInitial}"
                                                       FontSize="{StaticResource AuraFont13}"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image Source="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MyAvatarImage}"
                                                   IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).HasMyAvatar}"
                                                   Stretch="UniformToFill"/>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="{Binding Alignment}">
                                        <!-- name + timestamp on one baseline row. Reads name ·
                                             time · mention; the trailing two are docked right
                                             (so declared in reverse) and keep their width, and
                                             the name fills the rest and trims. -->
                                        <DockPanel Margin="2,0,2,3"
                                                   HorizontalAlignment="{Binding Alignment}"
                                                   IsVisible="{Binding !System}">
                                            <TextBlock DockPanel.Dock="Right" Classes="mono"
                                                       Text="mentions you"
                                                       FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraCautionTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       IsVisible="{Binding IsMention}"/>
                                            <TextBlock DockPanel.Dock="Right" Classes="mono"
                                                       Text="{Binding TimeLabel}"
                                                       FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraTextFaintBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding UserName}"
                                                       FontSize="{StaticResource AuraFont13}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AuraTextMidBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <Border Background="{Binding ., Converter={x:Static converters:ChatBubbleColorConverter.Instance}}"
                                                BorderBrush="{Binding ., Converter={x:Static converters:ChatBubbleBorderConverter.Instance}}"
                                                BorderThickness="{Binding System, Converter={x:Static converters:BoolToThicknessConverter.Instance}}"
                                                CornerRadius="{StaticResource AuraRadiusTile}"
                                                Padding="{Binding System, Converter={x:Static converters:SystemMessagePaddingConverter.Instance}}"
                                                MaxWidth="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ChatBubbleMaxWidth}"
                                                HorizontalAlignment="{Binding Alignment}"
                                                Opacity="{Binding BubbleOpacity}">
                                            <Border.ContextMenu>
                                                <ContextMenu IsVisible="{Binding !System}">
                                                    <MenuItem Header="Reply" Command="{Binding ReplyCommand}"/>
                                                    <MenuItem Header="Copy" Command="{Binding CopyCommand}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Spacing="{StaticResource AuraSpace5}">
                                                <!-- Reply context: 3px primary bar, sender mono, quoted line -->
                                                <Grid ColumnDefinitions="3,*" IsVisible="{Binding HasReply}">
                                                    <Border Grid.Column="0" CornerRadius="2"
                                                            Background="{DynamicResource AuraPrimarySoftBrush}"/>
                                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="1">
                                                        <TextBlock Classes="mono"
                                                                   Text="{Binding ReplySender}"
                                                                   FontSize="{StaticResource AuraMono9}"
                                                                   Foreground="{DynamicResource AuraLinkBrush}"/>
                                                        <TextBlock Text="{Binding ReplyPreview}"
                                                                   FontSize="{StaticResource AuraFont11}"
                                                                   Foreground="{Binding ., Converter={x:Static converters:ChatBubbleTextColorConverter.Instance}}"
                                                                   Opacity="0.75"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                                <controls:MarkdownText Markdown="{Binding Content}"
                                                                       MentionName="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DisplayName}"
                                                                       MentionBackground="{DynamicResource AuraMentionPillBrush}"
                                                                       MentionForeground="{DynamicResource AuraCautionTextBrush}"
                                                                       Foreground="{Binding ., Converter={x:Static converters:ChatBubbleTextColorConverter.Instance}}"
                                                                       LinkBrush="{Binding ., Converter={x:Static converters:ChatLinkBrushConverter.Instance}}"
                                                                       CodeBackground="{DynamicResource AuraWellBrush}"
                                                                       CodeFontFamily="{StaticResource AuraMonoFontFamily}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="{StaticResource AuraFont13}"/>

                                                <!-- E2EE file / image attachment -->
                                                <Border IsVisible="{Binding HasAttachment}"
                                                        Background="{DynamicResource AuraWellBrush}"
                                                        BorderBrush="{DynamicResource AuraDividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource AuraRadiusControl}"
                                                        Padding="10,8">
                                                    <StackPanel Spacing="{StaticResource AuraSpace5}">
                                                        <Image Source="{Binding AttachmentPreview}"
                                                               MaxWidth="280" MaxHeight="220"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding HasAttachmentPreview}"/>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{Binding AttachmentFileName}"
                                                                           FontSize="{StaticResource AuraFont12}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding ., Converter={x:Static converters:ChatBubbleTextColorConverter.Instance}}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Classes="mono"
                                                                               Text="{Binding AttachmentSizeLabel}"
                                                                               FontSize="{StaticResource AuraMono9}"
                                                                               Foreground="{DynamicResource AuraTextDimBrush}"/>
                                                                    <TextBlock Classes="mono"
                                                                               Text="{Binding AttachmentStatus}"
                                                                               FontSize="{StaticResource AuraMono9}"
                                                                               Foreground="{DynamicResource AuraTextDimBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="icon"
                                                                    Content="Save"
                                                                    Padding="8,4"
                                                                    FontSize="{StaticResource AuraFont11}"
                                                                    Command="{Binding SaveAttachmentCommand}"
                                                                    IsVisible="{Binding CanSaveAttachment}"
                                                                    VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Failed send: say why, offer retry -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{StaticResource AuraSpace8}"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,4,2,0"
                                                    IsVisible="{Binding SendFailed}">
                                            <TextBlock Classes="mono"
                                                       Text="{Binding SendErrorLabel}"
                                                       FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraDangerBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="320"
                                                       VerticalAlignment="Center"/>
                                            <Button Classes="icon" Padding="6,2"
                                                    Content="Retry"
                                                    FontSize="{StaticResource AuraFont11}"
                                                    Command="{Binding RetryCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- `N mentions below` — scrolls to the first one -->
                <Button x:Name="MentionsBelowPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,12"
                        Padding="12,5"
                        CornerRadius="{StaticResource AuraRadiusPill}"
                        Background="{DynamicResource AuraMentionFillBrush}"
                        BorderBrush="{DynamicResource AuraMentionBorderBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasMentionsBelow}">
                    <TextBlock Classes="mono" Text="{Binding MentionsBelowLabel}"
                               FontSize="{StaticResource AuraMono10}"
                               Foreground="{DynamicResource AuraCautionTextBrush}"/>
                </Button>
                </Panel>

                <!-- ── Reply bar ── -->
                <Border Grid.Row="4"
                        BorderBrush="{DynamicResource AuraDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8"
                        IsVisible="{Binding IsReplying}">
                    <Grid ColumnDefinitions="3,*,Auto">
                        <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource AuraPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="1">
                            <TextBlock Classes="mono"
                                       Text="{Binding ReplyBarTitle}"
                                       FontSize="{StaticResource AuraMono9}"
                                       Foreground="{DynamicResource AuraLinkBrush}"/>
                            <TextBlock Text="{Binding ReplyBarPreview}"
                                       FontSize="{StaticResource AuraFont11}"
                                       Foreground="{DynamicResource AuraTextDimBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="icon"
                                Content="✕"
                                Command="{Binding CancelReplyCommand}"
                                ToolTip.Tip="Cancel reply (Esc)"/>
                    </Grid>
                </Border>

                <!-- ── Composer ── -->
                <Border Grid.Row="5"
                        BorderBrush="{DynamicResource AuraDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0" Classes="icon"
                                Command="{Binding AttachFileCommand}"
                                Width="36" Height="36"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Send encrypted file (max 25 MiB)">
                            <TextBlock Text="+" FontSize="{StaticResource AuraFont16}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <TextBox x:Name="Composer"
                                 Grid.Column="1" Classes="aura"
                                 Text="{Binding MessageInput}"
                                 PlaceholderText="{Binding ComposerPlaceholder}"
                                 MaxLength="4000"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}"/>
                                <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendMessageCommand}"/>
                                <KeyBinding Gesture="Escape" Command="{Binding CancelReplyCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- Keycap hint, mono. Hidden in the narrow chat column. -->
                        <TextBlock Grid.Column="2" Classes="mono"
                                   Text="Ctrl↵"
                                   FontSize="{StaticResource AuraMono9}"
                                   Foreground="{DynamicResource AuraTextFaintBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsChatFirst}"/>

                        <Button Grid.Column="3" Classes="brand"
                                Command="{Binding SendMessageCommand}"
                                Width="36" Height="36"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Send (Enter)">
                            <TextBlock Text="➤" FontSize="{StaticResource AuraFont14}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================
                 VOICE RAIL (§3) / STAGE (§4). Same components, two sizes.
                 Only this column's width animates.
                 ======================================================== -->
            <Border Grid.Column="2"
                    Classes="modeColumn"
                    Width="{Binding VoiceColumnWidth}"
                    Background="{DynamicResource AuraSidebarOverlayBrush}"
                    BorderBrush="{DynamicResource AuraDividerBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- ── Rail header: "Voice" + latency pill ── -->
                    <Border Grid.Row="0" Height="46"
                            Background="{DynamicResource AuraChromeOverlayBrush}"
                            BorderBrush="{DynamicResource AuraDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Voice"
                                       FontSize="{StaticResource AuraFont13}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraTextBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Hidden when alone: a round-trip to nobody is not
                                 a measurement. -->
                            <Border Grid.Column="1" Classes="badge"
                                    Background="{DynamicResource AuraWellBrush}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding VoiceRail.ShowLatency}"
                                    ToolTip.Tip="{Binding CallQualitySummary}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace5}">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{Binding LatencyBrush}"/>
                                    <TextBlock Classes="mono"
                                               Text="{Binding LatencyLabel}"
                                               FontSize="{StaticResource AuraMono10}"
                                               Foreground="{DynamicResource AuraTextDimBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="14,14,14,0">
                        <StackPanel Spacing="{StaticResource AuraSpace12}">

                            <!-- ============ a. Current speaker card ============ -->
                            <Border Classes="panel"
                                    Background="{DynamicResource AuraAccentTintBrush}"
                                    BorderBrush="{DynamicResource AuraAccentBorderBrush}"
                                    Padding="14"
                                    IsVisible="{Binding VoiceRail.CurrentSpeaker, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="{StaticResource AuraSpace11}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <!-- Avatar + pulsing ring -->
                                        <Panel Grid.Column="0"
                                               Width="{Binding HeroAvatarSize}"
                                               Height="{Binding HeroAvatarSize}"
                                               Margin="0,0,11,0">
                                            <Border Classes="pulseRing"
                                                    Margin="-5"
                                                    CornerRadius="{StaticResource AuraRadiusTile}"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource AuraAccentRingBrush}"
                                                    IsVisible="{Binding VoiceRail.CurrentSpeaker.IsLive}"/>
                                            <Border CornerRadius="{StaticResource AuraRadiusAvatar}"
                                                    Background="{Binding VoiceRail.CurrentSpeaker.AvatarBrush}">
                                                <TextBlock Text="{Binding VoiceRail.CurrentSpeaker.Initial}"
                                                           FontSize="{StaticResource AuraFont18}"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Panel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Spacing="{StaticResource AuraSpace3}">
                                            <!-- Badge docked first so the name is what trims -->
                                            <DockPanel HorizontalAlignment="Left">
                                                <Border DockPanel.Dock="Right" Classes="badge"
                                                        Background="{DynamicResource AuraAccentPillFillBrush}"
                                                        BorderBrush="{DynamicResource AuraAccentPillBorderBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0"
                                                        IsVisible="{Binding VoiceRail.CurrentSpeaker.IsVerified}">
                                                    <TextBlock Classes="mono" Text="verified"
                                                               FontSize="{StaticResource AuraMono9}"
                                                               Foreground="{DynamicResource AuraAccentBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding VoiceRail.CurrentSpeaker.Name}"
                                                           FontSize="{Binding HeroNameFontSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AuraTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <!-- `speaking 0:12 · 41%` -->
                                            <TextBlock Classes="mono"
                                                       Text="{Binding VoiceRail.CurrentSpeaker.SubLine}"
                                                       FontSize="{StaticResource AuraMono10}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live waveform -->
                                    <controls:BarMeter Mode="Waveform"
                                                       Levels="{Binding VoiceRail.WaveformLevels}"
                                                       BarCount="{Binding WaveformBarCount}"
                                                       Height="{Binding WaveformHeight}"
                                                       BarGap="2" BarRadius="2"
                                                       BarBrush="{DynamicResource AuraAccentBrush}"
                                                       DimBarBrush="{DynamicResource AuraAccentSoftBrush}"/>

                                    <!-- This speaker's local playback gain — NOT master
                                         output. Hidden for the local user, who cannot
                                         hear themselves. -->
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          IsVisible="{Binding VoiceRail.CurrentSpeaker.CanAdjustVolume, FallbackValue=False}">
                                        <TextBlock Grid.Column="0" Text="🔊"
                                                   FontSize="{StaticResource AuraFont12}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                Value="{Binding VoiceRail.CurrentSpeaker.LocalVolume}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Classes="mono"
                                                   Text="{Binding VoiceRail.CurrentSpeaker.LocalVolume, StringFormat='{}{0}%'}"
                                                   FontSize="{StaticResource AuraMono10}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Empty state: a chip, never a spinner -->
                            <Border Classes="panel"
                                    Padding="14,12"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding VoiceRail.ShowEmptyState}">
                                <TextBlock Text="{Binding VoiceRail.EmptyStateText}"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                            </Border>

                            <!-- ============ b. LAST 3 MIN lanes ============
                                 Lanes are a comparison between people. Alone
                                 they showed one lane at "61%" of nothing, under
                                 a legend for overlaps that cannot happen. -->
                            <Border Classes="panel" Padding="14,13"
                                    IsVisible="{Binding VoiceRail.ShowLanes}">
                                <StackPanel Spacing="{StaticResource AuraSpace9}">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="monoLabel" Text="LAST 3 MIN"/>
                                        <!-- legend: overlap == talked over -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="{StaticResource AuraSpace5}">
                                            <Border Width="7" Height="7"
                                                    CornerRadius="1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AuraCautionBrush}"/>
                                            <TextBlock Classes="mono" Text="overlap"
                                                       FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding VoiceRail.Lanes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TalkLaneViewModel">
                                                <Grid ColumnDefinitions="16,Auto,*,30"
                                                      Margin="0,0,0,5"
                                                      Opacity="{Binding LaneOpacity}">
                                                    <Border Grid.Column="0" Width="16" Height="16"
                                                            CornerRadius="{StaticResource AuraRadiusAvatarSmall}"
                                                            Background="{Binding AvatarBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontSize="8"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Name column: voice-focus only, fades in -->
                                                    <TextBlock Grid.Column="1"
                                                               Classes="modeFade"
                                                               Text="{Binding Name}"
                                                               FontSize="{StaticResource AuraFont12}"
                                                               Foreground="{DynamicResource AuraTextMidBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"
                                                               Width="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LaneNameColumnWidth}"
                                                               Opacity="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ModeExtrasOpacity}"/>

                                                    <controls:TalkLane Grid.Column="2"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Height="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LaneHeight}"
                                                                       SegmentHeight="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LaneSegmentHeight}"
                                                                       SegmentRadius="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LaneSegmentRadius}"
                                                                       Segments="{Binding Segments}"
                                                                       Overlaps="{Binding Overlaps}"
                                                                       SegmentBrush="{Binding SegmentBrush}"
                                                                       LiveSegmentBrush="{DynamicResource AuraSegmentLiveBrush}"
                                                                       OverlapBrush="{DynamicResource AuraOverlapBrush}"
                                                                       TrackBrush="{DynamicResource AuraTrackBrush}"
                                                                       TrackBorderBrush="{DynamicResource AuraTrackBorderBrush}"/>

                                                    <TextBlock Grid.Column="3" Classes="mono"
                                                               Text="{Binding ShareLabel}"
                                                               FontSize="{StaticResource AuraMono9}"
                                                               Foreground="{DynamicResource AuraTextDimBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Lane overflow: top 5 + "N others", expandable -->
                                    <Button Classes="row"
                                            Padding="0,4"
                                            Command="{Binding VoiceRail.ToggleOverflowCommand}"
                                            IsVisible="{Binding VoiceRail.HasOverflow}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}"
                                                    Margin="24,0,0,0">
                                            <TextBlock Classes="mono"
                                                       Text="{Binding VoiceRail.OverflowLabel}"
                                                       FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                                            <TextBlock Text="▾" FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Time axis: stage only, fades across the swap -->
                                    <Grid Classes="modeFade"
                                          ColumnDefinitions="*,*,*,Auto"
                                          Margin="86,0,0,0"
                                          Height="{Binding TimeAxisHeight}"
                                          Opacity="{Binding ModeExtrasOpacity}">
                                        <TextBlock Grid.Column="0" Classes="mono" Text="−3 min"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                        <TextBlock Grid.Column="1" Classes="mono" Text="−2 min"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                        <TextBlock Grid.Column="2" Classes="mono" Text="−1 min"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                        <TextBlock Grid.Column="3" Classes="mono" Text="now"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============ c. SILENT ============ -->
                            <StackPanel Spacing="{StaticResource AuraSpace8}"
                                        IsVisible="{Binding VoiceRail.ShowSilent}">
                                <TextBlock Classes="monoLabel" Text="SILENT"/>
                                <ItemsControl ItemsSource="{Binding VoiceRail.SilentMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SilentMemberViewModel">
                                            <!-- `verify key` rows open the trust sheet on that member -->
                                            <Button Classes="row" Padding="0" Margin="0,0,0,5"
                                                    IsHitTestVisible="{Binding NeedsTrust}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenTrustForSessionCommand}"
                                                    CommandParameter="{Binding SessionId}">
                                            <Border CornerRadius="{StaticResource AuraRadiusTile}"
                                                    Padding="12,8"
                                                    Background="{Binding NeedsTrust, Converter={x:Static converters:TrustRowBrushConverter.Fill}}"
                                                    BorderBrush="{Binding NeedsTrust, Converter={x:Static converters:TrustRowBrushConverter.Border}}"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="22" Height="22"
                                                            Margin="0,0,10,0"
                                                            CornerRadius="{StaticResource AuraRadiusAvatarSmall}"
                                                            Background="{Binding AvatarBrush}">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontSize="{StaticResource AuraMono9}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               FontSize="{StaticResource AuraFont12}"
                                                               Foreground="{DynamicResource AuraTextMidBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2" Classes="mono"
                                                               Text="{Binding StateLabel}"
                                                               FontSize="{StaticResource AuraMono9}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding NeedsTrust, Converter={x:Static converters:TrustRowBrushConverter.Text}}"/>
                                                </Grid>
                                            </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ d. Command HUD ============
                         Docked CommandBar at the pane bottom — the desktop
                         translation of the floating macOS capsule. -->
                    <CommandBar Grid.Row="2"
                                Background="{DynamicResource AuraChromeOverlayBrush}"
                                BorderBrush="{DynamicResource AuraDividerBrush}"
                                BorderThickness="0,1,0,0"
                                IsEnabled="{Binding IsAuthenticated}">
                        <CommandBar.Content>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                                  Margin="14,10"
                                  VerticalAlignment="Center">

                                <!-- Mic / deafen segmented pair in a well -->
                                <Border Grid.Column="0" Classes="well" Padding="3">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <!-- Plain buttons whose look follows the view model one
                                             way. A ToggleButton flips itself AND runs the command,
                                             so a click toggled twice and netted nothing. -->
                                        <Button Command="{Binding ToggleMicrophoneCommand}"
                                                Classes="hudSegment"
                                                Classes.on="{Binding IsMicEnabled}"
                                                ToolTip.Tip="Microphone (Ctrl+M / Cmd+M)">
                                            <TextBlock Text="{Binding IsMicEnabled, Converter={x:Static converters:MicIconConverter.Instance}}"
                                                       FontSize="{StaticResource AuraFont16}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Command="{Binding ToggleDeafenCommand}"
                                                Classes="hudSegment"
                                                Classes.on="{Binding IsDeafened}"
                                                ToolTip.Tip="Deafen (Ctrl+D / Cmd+D)">
                                            <TextBlock Text="{Binding IsDeafened, Converter={x:Static converters:DeafenIconConverter.Instance}}"
                                                       FontSize="{StaticResource AuraFont16}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Input meter -->
                                <StackPanel Grid.Column="1" Spacing="{StaticResource AuraSpace3}"
                                            Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="monoLabel" Text="INPUT"/>
                                        <TextBlock Grid.Column="2" Classes="mono"
                                                   Text="{Binding VoiceRail.InputDbLabel}"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                    <controls:BarMeter Mode="Level"
                                                       Level="{Binding VoiceRail.InputLevel}"
                                                       BarCount="9" BarGap="2" BarRadius="1"
                                                       Width="72" Height="14"
                                                       BarBrush="{DynamicResource AuraAccentBrush}"
                                                       DimBarBrush="{DynamicResource AuraTrackBrush}"/>
                                </StackPanel>

                                <!-- PTT chip: `PTT · Ctrl+Space`, `held 0:04` while down -->
                                <Border Grid.Column="2" Classes="well"
                                        Padding="10,6" Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding HudModeTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace5}">
                                        <TextBlock Classes="mono" Text="{Binding HudModeLabel}"
                                                   FontSize="{StaticResource AuraMono10}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"/>
                                        <TextBlock Classes="mono" Text="{Binding HudModeKey}"
                                                   FontSize="{StaticResource AuraMono10}"
                                                   Foreground="{DynamicResource AuraAccentBrush}"/>
                                        <TextBlock Classes="mono"
                                                   Text="{Binding PttHeldLabel}"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"
                                                   IsVisible="{Binding IsPushToTalkHeld}"/>
                                    </StackPanel>
                                </Border>

                                <!-- RNNoise: ToggleSwitch, the Fluent idiom. Stage only —
                                     the 336px rail has no room for it. -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            Spacing="{StaticResource AuraSpace8}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsVoiceFocus}">
                                    <TextBlock Text="RNNoise"
                                               FontSize="{StaticResource AuraFont12}"
                                               Foreground="{DynamicResource AuraTextDimBrush}"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch IsChecked="{Binding RnnoiseEnabled}"
                                                  OnContent="" OffContent=""
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </CommandBar.Content>
                    </CommandBar>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================
             Trust sheet (§7) — makes E2EE legible.

             A sheet over the channel rather than a separate window: the room
             stays visible behind it, which is the point of the material. The
             scrim also swallows clicks, so the sheet is modal without a dialog.
             ================================================================ -->
        <Border IsVisible="{Binding TrustSheet.IsOpen}"
                Background="#99000000">
            <Border Width="560"
                    MaxHeight="720"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Classes="sheet"
                    Padding="18">
                <DockPanel LastChildFill="True">

                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource AuraSpace3}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="CHANNEL SECURITY"
                                       Classes="monoLabel"
                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Command="{Binding TrustSheet.CloseCommand}"
                                    Content="✕"
                                    ToolTip.Tip="Close (Esc)"/>
                        </Grid>

                        <TextBlock FontSize="{StaticResource AuraFont14}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AuraTextBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{Binding TrustSheet.ChannelName, Mode=OneWay}"/><Run Text=" is end-to-end encrypted"/>
                        </TextBlock>

                        <TextBlock Text="{Binding TrustSheet.SecurityLine}"
                                   Classes="mono"
                                   FontSize="{StaticResource AuraMono11}"
                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Your server relays ciphertext only."
                                   FontSize="{StaticResource AuraFont12}"
                                   Foreground="{DynamicResource AuraTextFaintBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- Something went wrong reading the group. -->
                        <Border IsVisible="{Binding TrustSheet.HasError}"
                                Background="{DynamicResource AuraDangerFillBrush}"
                                BorderBrush="{DynamicResource AuraDangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="11"
                                Margin="0,8,0,0">
                            <TextBlock Text="{Binding TrustSheet.Error}"
                                       FontSize="{StaticResource AuraFont12}"
                                       Foreground="{DynamicResource AuraTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Key-changed banner. Amber, not red: a reinstall and a
                             takeover look identical from here, so it warns rather
                             than accuses. -->
                        <Border IsVisible="{Binding TrustSheet.ShowKeyChangedBanner}"
                                Background="{DynamicResource AuraCautionFillBrush}"
                                BorderBrush="{DynamicResource AuraCautionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="11"
                                Margin="0,10,0,0">
                            <StackPanel Spacing="{StaticResource AuraSpace3}">
                                <TextBlock Text="{Binding TrustSheet.KeyChangedTitle}"
                                           FontSize="{StaticResource AuraFont13}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraCautionTextBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TrustSheet.KeyChangedBody}"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actions, pinned to the bottom so they stay reachable
                         however long the member list gets. -->
                    <Grid DockPanel.Dock="Bottom"
                          ColumnDefinitions="*,Auto"
                          Margin="0,14,0,0"
                          IsVisible="{Binding TrustSheet.CanAct}">
                        <Button Classes="brand" Grid.Column="0"
                                Command="{Binding TrustSheet.MarkVerifiedCommand}"
                                Background="{DynamicResource AuraBrandGradientBrush}"
                                Foreground="White"
                                FontSize="{StaticResource AuraFont13}"
                                FontWeight="SemiBold"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="14,9"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Content="They match — mark verified"/>
                        <Button Classes="danger" Grid.Column="1"
                                Command="{Binding TrustSheet.BlockCommand}"
                                Background="{DynamicResource AuraDangerFillBrush}"
                                BorderBrush="{DynamicResource AuraDangerBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource AuraDangerBrush}"
                                FontSize="{StaticResource AuraFont13}"
                                FontWeight="SemiBold"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="14,9"
                                Margin="8,0,0,0"
                                Content="Block"/>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="{StaticResource AuraSpace14}" Margin="0,14,0,0">

                            <!-- Safety words -->
                            <StackPanel Spacing="{StaticResource AuraSpace8}"
                                        IsVisible="{Binding TrustSheet.PairLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding TrustSheet.PairLabel}"
                                           Classes="monoLabel"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>

                                <ItemsControl ItemsSource="{Binding TrustSheet.SafetyWords}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AuraWellBrush}"
                                                    BorderBrush="{DynamicResource AuraTrackBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                                    Padding="10,8"
                                                    Margin="0,0,6,6">
                                                <!-- Selectable: users paste these into
                                                     whatever out-of-band channel they trust. -->
                                                <SelectableTextBlock Text="{Binding}"
                                                                     Classes="mono"
                                                                     FontSize="{StaticResource AuraMono13}"
                                                                     Foreground="{DynamicResource AuraTextBrush}"
                                                                     HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Deriving takes an scrypt run; a chip, never a spinner. -->
                            <Border IsVisible="{Binding TrustSheet.IsDeriving}"
                                    Background="{DynamicResource AuraWellBrush}"
                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                    Padding="12,9"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="deriving safety words…"
                                           Classes="mono"
                                           FontSize="{StaticResource AuraMono11}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                            </Border>

                            <!-- The full fingerprint pair: the authoritative
                                 comparison the words are a convenience over. -->
                            <StackPanel Spacing="{StaticResource AuraSpace5}"
                                        IsVisible="{Binding TrustSheet.RemoteFingerprint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <SelectableTextBlock Text="{Binding TrustSheet.RemoteFingerprint}"
                                                     Classes="mono"
                                                     FontSize="{StaticResource AuraMono11}"
                                                     Foreground="{DynamicResource AuraTextMidBrush}"
                                                     TextWrapping="Wrap"/>
                                <SelectableTextBlock Text="{Binding TrustSheet.LocalFingerprint}"
                                                     Classes="mono"
                                                     FontSize="{StaticResource AuraMono11}"
                                                     Foreground="{DynamicResource AuraTextDimBrush}"
                                                     TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Members -->
                            <StackPanel Spacing="{StaticResource AuraSpace5}">
                                <TextBlock Text="MEMBERS"
                                           Classes="monoLabel"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>

                                <ItemsControl ItemsSource="{Binding TrustSheet.Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TrustMemberViewModel">
                                            <Button Classes="row"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TrustSheet.SelectCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0"
                                                            Width="3" Height="18"
                                                            CornerRadius="2"
                                                            Margin="0,0,9,0"
                                                            Background="{DynamicResource AuraAccentBrush}"
                                                            IsVisible="{Binding IsSelected}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="{StaticResource AuraFont13}"
                                                               Foreground="{DynamicResource AuraTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding StateLabel}"
                                                               Classes="mono"
                                                               FontSize="{StaticResource AuraMono10}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- ================================================================
             Moderation console (admins). Same scrim-over-the-room sheet as the
             trust sheet: a searchable member table on the left, the selected
             member's actions on the right.
             ================================================================ -->
        <Border IsVisible="{Binding Moderation.IsOpen}" Background="#99000000">
            <!-- 600 high when there is room, less when the window is shorter:
                 stretched within a margin and capped, which also centres it. -->
            <Border Width="900"
                    MaxHeight="600"
                    Margin="0,16"
                    VerticalAlignment="Stretch" HorizontalAlignment="Center"
                    Classes="sheet"
                    Padding="18">
                <DockPanel LastChildFill="True">

                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="{StaticResource AuraSpace2}">
                            <TextBlock Text="{Binding Moderation.HostLabel}"
                                       Classes="monoLabel"
                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                            <TextBlock Text="Server members" Classes="title"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Content="✕"
                                Command="{Binding Moderation.CloseCommand}"
                                VerticalAlignment="Top"
                                ToolTip.Tip="Close (Esc)"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,16,300">

                        <!-- Left: search, filters, table -->
                        <DockPanel Grid.Column="0" LastChildFill="True">
                            <TextBox DockPanel.Dock="Top" Classes="aura"
                                     Text="{Binding Moderation.Search}"
                                     PlaceholderText="Search by name or user id (U_…)"
                                     Margin="0,0,0,10"/>

                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button Classes="chip" Classes.on="{Binding Moderation.FilterIsAll}"
                                        Command="{Binding Moderation.SetFilterCommand}"
                                        CommandParameter="{x:Static svc:MemberFilter.All}"
                                        Margin="0,0,6,6" FontSize="{StaticResource AuraFont11}"
                                        Content="{Binding Moderation.AllLabel}"/>
                                <Button Classes="chip" Classes.on="{Binding Moderation.FilterIsOnline}"
                                        Command="{Binding Moderation.SetFilterCommand}"
                                        CommandParameter="{x:Static svc:MemberFilter.Online}"
                                        Margin="0,0,6,6" FontSize="{StaticResource AuraFont11}"
                                        Content="{Binding Moderation.OnlineLabel}"/>
                                <Button Classes="chip" Classes.on="{Binding Moderation.FilterIsAwaiting}"
                                        Command="{Binding Moderation.SetFilterCommand}"
                                        CommandParameter="{x:Static svc:MemberFilter.Awaiting}"
                                        Margin="0,0,6,6" FontSize="{StaticResource AuraFont11}"
                                        Content="{Binding Moderation.AwaitingLabel}"/>
                                <Button Classes="chip" Classes.on="{Binding Moderation.FilterIsBanned}"
                                        Command="{Binding Moderation.SetFilterCommand}"
                                        CommandParameter="{x:Static svc:MemberFilter.Banned}"
                                        Margin="0,0,6,6" FontSize="{StaticResource AuraFont11}"
                                        Content="{Binding Moderation.BannedLabel}"/>
                            </WrapPanel>

                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,90,110" Margin="11,0,11,4">
                                <TextBlock Grid.Column="0" Text="MEMBER" Classes="monoLabel"/>
                                <TextBlock Grid.Column="1" Text="STANDING" Classes="monoLabel"/>
                                <TextBlock Grid.Column="2" Text="STATUS" Classes="monoLabel"/>
                            </Grid>

                            <Border DockPanel.Dock="Top" Background="{DynamicResource AuraDangerFillBrush}"
                                    BorderBrush="{DynamicResource AuraDangerBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource AuraRadiusControl}" Padding="10,8"
                                    IsVisible="{Binding Moderation.HasListError}">
                                <TextBlock Text="{Binding Moderation.ListError}"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraDangerBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock DockPanel.Dock="Top" Text="Loading…"
                                       IsVisible="{Binding Moderation.IsLoading}"
                                       FontSize="{StaticResource AuraFont12}"
                                       Foreground="{DynamicResource AuraTextDimBrush}"
                                       Margin="11,6"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Moderation.EmptyText}"
                                       IsVisible="{Binding Moderation.ShowEmpty}"
                                       FontSize="{StaticResource AuraFont12}"
                                       Foreground="{DynamicResource AuraTextDimBrush}"
                                       Margin="11,6"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Moderation.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModerationRowViewModel">
                                            <Button Classes="row"
                                                    Padding="11,7"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Moderation.SelectCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="3,*,90,110">
                                                    <Border Grid.Column="0" Width="3" Height="26"
                                                            CornerRadius="2" Margin="0,0,8,0"
                                                            Background="{DynamicResource AuraAccentBrush}"
                                                            IsVisible="{Binding IsSelected}"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}">
                                                        <Border Width="26" Height="26"
                                                                CornerRadius="{StaticResource AuraRadiusAvatarSmall}"
                                                                Background="{DynamicResource AuraWellBrush}">
                                                            <TextBlock Text="{Binding Initial}"
                                                                       FontSize="{StaticResource AuraFont12}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AuraTextBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="{StaticResource AuraFont13}"
                                                                       Foreground="{DynamicResource AuraTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ShortId}"
                                                                       Classes="mono"
                                                                       FontSize="{StaticResource AuraMono10}"
                                                                       Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Panel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding StandingLabel}" Classes="mono"
                                                                   FontSize="{StaticResource AuraMono10}"
                                                                   Foreground="{DynamicResource AuraLinkBrush}"
                                                                   IsVisible="{Binding IsAdminStanding}"/>
                                                        <TextBlock Text="{Binding StandingLabel}" Classes="mono"
                                                                   FontSize="{StaticResource AuraMono10}"
                                                                   Foreground="{DynamicResource AuraGoodBrush}"
                                                                   IsVisible="{Binding IsVerifiedStanding}"/>
                                                        <TextBlock Text="{Binding StandingLabel}" Classes="mono"
                                                                   FontSize="{StaticResource AuraMono10}"
                                                                   Foreground="{DynamicResource AuraCautionTextBrush}"
                                                                   IsVisible="{Binding IsUnverifiedStanding}"/>
                                                        <TextBlock Text="{Binding StandingLabel}" Classes="mono"
                                                                   FontSize="{StaticResource AuraMono10}"
                                                                   Foreground="{DynamicResource AuraDangerBrush}"
                                                                   IsVisible="{Binding IsBanned}"/>
                                                    </Panel>

                                                    <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                               FontSize="{StaticResource AuraFont12}"
                                                               Foreground="{DynamicResource AuraTextDimBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Right: the selected member -->
                        <Border Grid.Column="2"
                                Classes="well"
                                Padding="14">
                            <Panel>
                                <TextBlock Text="Select a member to see what you can do."
                                           IsVisible="{Binding !Moderation.HasSelection}"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"
                                           TextWrapping="Wrap"/>

                                <ScrollViewer IsVisible="{Binding Moderation.HasSelection}"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="{StaticResource AuraSpace9}">
                                        <StackPanel Spacing="{StaticResource AuraSpace2}">
                                            <TextBlock Text="{Binding Moderation.SelectedName}"
                                                       FontSize="{StaticResource AuraFont14}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AuraTextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Moderation.SelectedShortId}"
                                                       Classes="mono"
                                                       FontSize="{StaticResource AuraMono10}"
                                                       Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                            <TextBlock FontSize="{StaticResource AuraFont12}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}">
                                                <Run Text="{Binding Moderation.SelectedStandingLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Moderation.SelectedJoined, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Moderation.SelectedStatus, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Text="Verifying marks the account as known to this server. It is separate from comparing safety words, which checks a person's encryption key."
                                                   FontSize="{StaticResource AuraFont11}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                   TextWrapping="Wrap"/>

                                        <!-- The server's refusal / confirmation of the last action -->
                                        <Border IsVisible="{Binding Moderation.HasActionError}"
                                                Background="{DynamicResource AuraDangerFillBrush}"
                                                BorderBrush="{DynamicResource AuraDangerBorderBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="8,6">
                                            <TextBlock Text="{Binding Moderation.ActionError}"
                                                       FontSize="{StaticResource AuraFont11}"
                                                       Foreground="{DynamicResource AuraDangerBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                        <TextBlock Text="{Binding Moderation.ActionStatus}"
                                                   IsVisible="{Binding Moderation.HasActionStatus}"
                                                   FontSize="{StaticResource AuraFont11}"
                                                   Foreground="{DynamicResource AuraGoodBrush}"/>

                                        <Button Content="Verify account"
                                                Command="{Binding Moderation.VerifyCommand}"
                                                IsEnabled="{Binding Moderation.CanVerify}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                                FontSize="{StaticResource AuraFont12}"/>

                                        <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>

                                        <TextBox Classes="aura"
                                                 Text="{Binding Moderation.KickReason}"
                                                 PlaceholderText="Message to them (optional)"
                                                 MaxLength="200"/>
                                        <Button Content="Move to lobby"
                                                Command="{Binding Moderation.MoveToLobbyCommand}"
                                                IsEnabled="{Binding Moderation.CanMoveToLobby}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                                FontSize="{StaticResource AuraFont12}"/>
                                        <TextBlock Text="{Binding Moderation.MoveToLobbyHint}"
                                                   FontSize="{StaticResource AuraFont11}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>

                                        <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>

                                        <TextBox Classes="aura"
                                                 Text="{Binding Moderation.BanReason}"
                                                 PlaceholderText="Reason (server log only)"
                                                 MaxLength="200"/>

                                        <!-- Ban asks twice; unban doesn't. -->
                                        <Button Classes="danger" Content="{Binding Moderation.BanButtonLabel}"
                                                Command="{Binding Moderation.BanCommand}"
                                                IsVisible="{Binding !Moderation.ConfirmingBan}"
                                                IsEnabled="{Binding Moderation.CanBan}"
                                                Background="{DynamicResource AuraDangerFillBrush}"
                                                Foreground="{DynamicResource AuraDangerBrush}"
                                                BorderBrush="{DynamicResource AuraDangerBorderBrush}" BorderThickness="1"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                                FontSize="{StaticResource AuraFont12}"/>
                                        <StackPanel IsVisible="{Binding Moderation.ConfirmingBan}" Spacing="{StaticResource AuraSpace5}">
                                            <TextBlock Text="Ban this account? They are disconnected now and refused at login until unbanned."
                                                       FontSize="{StaticResource AuraFont11}"
                                                       Foreground="{DynamicResource AuraDangerBrush}"
                                                       TextWrapping="Wrap"/>
                                            <Grid ColumnDefinitions="*,8,*">
                                                <Button Grid.Column="0" Content="Cancel"
                                                        Command="{Binding Moderation.CancelBanCommand}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                                        FontSize="{StaticResource AuraFont12}"/>
                                                <Button Classes="dangerSolid" Grid.Column="2" Content="Confirm ban"
                                                        Command="{Binding Moderation.BanCommand}"
                                                        IsEnabled="{Binding Moderation.CanBan}"
                                                        Background="{DynamicResource AuraDangerBrush}" Foreground="White"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                                        FontSize="{StaticResource AuraFont12}"/>
                                            </Grid>
                                        </StackPanel>
                                        <Button Content="Unban"
                                                Command="{Binding Moderation.UnbanCommand}"
                                                IsVisible="{Binding Moderation.SelectedIsBanned}"
                                                IsEnabled="{Binding Moderation.CanUnban}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                                FontSize="{StaticResource AuraFont12}"/>

                                        <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>

                                        <!-- Admin permissions. The client doesn't learn a
                                             target's current permissions, so all start off. -->
                                        <Button Content="{Binding Moderation.GrantButtonLabel}"
                                                Command="{Binding Moderation.ToggleGrantCommand}"
                                                IsEnabled="{Binding Moderation.CanOpenGrant}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                                FontSize="{StaticResource AuraFont12}"/>
                                        <StackPanel IsVisible="{Binding Moderation.ShowGrant}" Spacing="{StaticResource AuraSpace3}">
                                            <TextBlock Text="Replaces their permissions with the ones ticked here. None ticked removes admin."
                                                       FontSize="{StaticResource AuraFont11}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}"
                                                       TextWrapping="Wrap"/>
                                            <CheckBox Content="Verify users" IsChecked="{Binding Moderation.GrantVerifyUsers}"/>
                                            <CheckBox Content="Ban and kick users" IsChecked="{Binding Moderation.GrantBanUsers}"/>
                                            <CheckBox Content="Grant admin" IsChecked="{Binding Moderation.GrantGrantAdmin}"/>
                                            <CheckBox Content="Manage channels" IsChecked="{Binding Moderation.GrantManageChannels}"/>
                                            <Button Classes="brand" Content="{Binding Moderation.GrantApplyLabel}"
                                                    Command="{Binding Moderation.ApplyGrantCommand}"
                                                    IsEnabled="{Binding Moderation.CanApplyGrant}"
                                                    Background="{DynamicResource AuraBrandGradientBrush}" Foreground="White"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                                    FontSize="{StaticResource AuraFont12}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- ================================================================
             Settings sheet. Same scrim-over-the-room pattern as the trust
             sheet; replaces the panel that used to squeeze into the roster.
             ================================================================ -->
        <Border IsVisible="{Binding ShowSettings}" Background="#99000000">
            <Border Width="520" MaxHeight="720"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Classes="sheet"
                    Padding="18">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Classes="title" Text="Settings" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="icon" Content="✕"
                                Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="Close (Esc)"/>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="{StaticResource AuraSpace12}">

                            <TextBlock Classes="monoLabel" Text="APPEARANCE"/>
                            <Grid ColumnDefinitions="*,*" >
                                <ComboBox Classes="aura" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedIndex="{Binding ThemeIndex}"/>
                                <ComboBox Classes="aura" Grid.Column="1" HorizontalAlignment="Stretch" Margin="6,0,0,0"
                                          ItemsSource="{Binding AppearanceOptions}"
                                          SelectedIndex="{Binding AppearanceIndex}"/>
                            </Grid>

                            <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>
                            <TextBlock Classes="monoLabel" Text="TRANSMISSION"/>
                            <ComboBox Classes="aura" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding TransmissionOptions}"
                                      SelectedIndex="{Binding TransmissionIndex}"/>

                            <StackPanel Spacing="{StaticResource AuraSpace5}" IsVisible="{Binding IsPushToTalkMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Push-to-Talk key"
                                               FontSize="{StaticResource AuraFont12}"
                                               Foreground="{DynamicResource AuraTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="icon"
                                            Command="{Binding RecordPttKeyCommand}"
                                            ToolTip.Tip="Click, then press the key you want (Esc cancels)">
                                        <Border Classes="well" Padding="10,4">
                                            <TextBlock Classes="mono" Text="{Binding PttKeyLabel}"
                                                       FontSize="{StaticResource AuraMono11}"
                                                       Foreground="{DynamicResource AuraAccentBrush}"/>
                                        </Border>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding PttScopeNote}"
                                           FontSize="{StaticResource AuraFont11}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="{StaticResource AuraSpace3}" IsVisible="{Binding IsVoiceActivationMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Sensitivity"
                                               FontSize="{StaticResource AuraFont12}"
                                               Foreground="{DynamicResource AuraTextBrush}"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding VadThresholdLabel}"
                                               FontSize="{StaticResource AuraMono10}"
                                               Foreground="{DynamicResource AuraTextDimBrush}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding VadSensitivity}"
                                        IsSnapToTickEnabled="True" TickFrequency="5"/>
                                <TextBlock Text="Left picks up quiet speech; right needs you to speak up."
                                           FontSize="{StaticResource AuraFont11}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>
                            <TextBlock Classes="monoLabel" Text="PROCESSING"/>
                            <ToggleSwitch IsChecked="{Binding RnnoiseEnabled}" Content="RNNoise suppression" OnContent="" OffContent=""/>
                            <ToggleSwitch IsChecked="{Binding AecEnabled}" Content="Echo cancellation" OnContent="" OffContent=""/>
                            <ToggleSwitch IsChecked="{Binding WebrtcNsEnabled}" Content="WebRTC noise suppression" OnContent="" OffContent=""/>
                            <ToggleSwitch IsChecked="{Binding AgcEnabled}" Content="Auto gain control" OnContent="" OffContent=""/>

                            <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>
                            <TextBlock Classes="monoLabel" Text="OUTPUT"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding MasterVolume}"
                                        IsSnapToTickEnabled="True" TickFrequency="5"/>
                                <TextBlock Grid.Column="1" Classes="mono"
                                           Text="{Binding MasterVolume, StringFormat='{}{0}%'}"
                                           FontSize="{StaticResource AuraMono10}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>

                            <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>
                            <TextBlock Classes="monoLabel" Text="LATENCY"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding JitterBufferMs}"
                                        IsSnapToTickEnabled="True" TickFrequency="10"/>
                                <TextBlock Grid.Column="1" Classes="mono"
                                           Text="{Binding JitterBufferMs, StringFormat='jitter {0} ms'}"
                                           FontSize="{StaticResource AuraMono10}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0" Minimum="0" Maximum="10" Value="{Binding DredDuration}"
                                        IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Grid.Column="1" Classes="mono"
                                           Text="{Binding DredDuration, StringFormat='DRED {0}0 ms'}"
                                           FontSize="{StaticResource AuraMono10}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Input device"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Classes="aura" MinWidth="170"
                                          ItemsSource="{Binding InputDeviceOptions}"
                                          SelectedIndex="{Binding InputDeviceIndex}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Output device"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Classes="aura" MinWidth="170"
                                          ItemsSource="{Binding OutputDeviceOptions}"
                                          SelectedIndex="{Binding OutputDeviceIndex}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="System Default follows your OS audio routing."
                                           FontSize="{StaticResource AuraFont11}"
                                           Foreground="{DynamicResource AuraTextFaintBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="icon"
                                        Content="Refresh"
                                        Padding="8,4"
                                        FontSize="{StaticResource AuraFont11}"
                                        Command="{Binding RefreshAudioDevicesCommand}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Opus bitrate"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Classes="aura" MinWidth="150"
                                          ItemsSource="{Binding BitrateOptions}"
                                          SelectedIndex="{Binding BitrateIndex}"/>
                            </Grid>
                            <ToggleSwitch IsChecked="{Binding VoiceSoundCuesEnabled}"
                                          Content="Voice Sound Cues"
                                          OnContent="" OffContent=""/>
                            <ToggleSwitch IsChecked="{Binding IsMicLoopbackActive}"
                                          Content="Test Mic (Loopback)"
                                          OnContent="" OffContent=""/>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding LoopbackLevel}"
                                         Height="6"
                                         CornerRadius="3"
                                         IsVisible="{Binding IsMicLoopbackActive}"/>
                            <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>
                            <TextBlock Classes="monoLabel" Text="NOTIFICATIONS"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Notify me about"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Classes="aura" MinWidth="150"
                                          ItemsSource="{Binding NotifyLevelOptions}"
                                          SelectedIndex="{Binding NotifyLevelIndex}"/>
                            </Grid>
                            <StackPanel Spacing="{StaticResource AuraSpace3}">
                                <TextBlock Text="Also notify on these words"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextBrush}"/>
                                <TextBox Classes="aura" Text="{Binding NotifyKeywords}"
                                         PlaceholderText="raid, standup, deploy"/>
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding NotifyShowText}" Content="Show message text in banners" OnContent="" OffContent=""/>
                            <ToggleSwitch IsChecked="{Binding NotifyBadge}" Content="Count mentions on the app icon" OnContent="" OffContent=""/>
                            <ToggleSwitch IsChecked="{Binding NotifyJoinLeave}" Content="Join and leave banners" OnContent="" OffContent=""/>

                            <Separator Background="{DynamicResource AuraDividerBrush}" Height="1"/>
                            <TextBlock Classes="monoLabel" Text="IDENTITY"/>
                            <Border Classes="panel" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0"
                                            VerticalAlignment="Top"
                                            CornerRadius="{StaticResource AuraRadiusAvatar}"
                                            Background="{DynamicResource AuraBrandGradientBrush}">
                                        <TextBlock Text="{Binding IdentityInitial}"
                                                   FontSize="{StaticResource AuraFont14}" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource AuraSpace3}">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{StaticResource AuraFont13}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AuraTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <SelectableTextBlock Classes="mono" Text="{Binding IdentityFingerprintFull}"
                                                             FontSize="{StaticResource AuraMono10}"
                                                             Foreground="{DynamicResource AuraAccentBrush}"
                                                             TextWrapping="Wrap"/>
                                        <TextBlock Text="Hybrid Ed25519 + ML-DSA-65 key, kept on this device"
                                                   FontSize="{StaticResource AuraFont11}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Classes="mono" Text="{Binding LastBackupLabel}"
                                                   FontSize="{StaticResource AuraMono10}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                   IsVisible="{Binding !NeverBackedUp}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Padding="12,9"
                                    CornerRadius="{StaticResource AuraRadiusTile}"
                                    BorderThickness="1"
                                    Background="{DynamicResource AuraCautionFillBrush}"
                                    BorderBrush="{DynamicResource AuraCautionBorderBrush}"
                                    IsVisible="{Binding NeverBackedUp}">
                                <TextBlock Text="Never backed up. If this device is lost, your name on each server stays taken by a key you no longer have, and everyone who verified you will see &quot;key changed&quot;."
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraCautionTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBox Classes="aura" PasswordChar="•"
                                     Text="{Binding BackupPassphrase}"
                                     PlaceholderText="Backup passphrase (at least 8 characters)"/>
                            <TextBox Classes="aura" PasswordChar="•"
                                     Text="{Binding BackupPassphraseRepeat}"
                                     PlaceholderText="Repeat passphrase (to save a backup)"/>
                            <TextBlock Text="{Binding PassphraseProblem}"
                                       IsVisible="{Binding PassphraseProblem, Converter={StaticResource StringToBoolConverter}}"
                                       FontSize="{StaticResource AuraFont11}"
                                       Foreground="{DynamicResource AuraCautionTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}">
                                <Button Classes="brand" Content="Save encrypted backup…"
                                        Command="{Binding SaveBackupCommand}"
                                        IsEnabled="{Binding CanSaveBackup}"
                                        Background="{DynamicResource AuraBrandGradientBrush}" Foreground="White"
                                        CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                        FontSize="{StaticResource AuraFont12}"/>
                                <Button Content="Restore from backup…"
                                        Command="{Binding RestoreBackupCommand}"
                                        IsEnabled="{Binding CanRestoreBackup}"
                                        CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                        FontSize="{StaticResource AuraFont12}"/>
                                <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center"
                                             IsVisible="{Binding IsIdentityBusy}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IdentityStatus}"
                                       IsVisible="{Binding IdentityStatus, Converter={StaticResource StringToBoolConverter}}"
                                       FontSize="{StaticResource AuraFont11}"
                                       Foreground="{DynamicResource AuraAccentBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding IdentityError}"
                                       IsVisible="{Binding IdentityError, Converter={StaticResource StringToBoolConverter}}"
                                       FontSize="{StaticResource AuraFont11}"
                                       Foreground="{DynamicResource AuraDangerBrush}" TextWrapping="Wrap"/>
                            <Button Classes="danger" Content="Leave server…"
                                    Command="{Binding AskLeaveServerCommand}"
                                    IsVisible="{Binding IsAuthenticated}"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AuraDangerFillBrush}"
                                    Foreground="{DynamicResource AuraDangerBrush}"
                                    BorderBrush="{DynamicResource AuraDangerBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                    FontSize="{StaticResource AuraFont12}"/>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- ================================================================
             Profile / comment card (§6). Click any roster name.
             ================================================================ -->
        <Border IsVisible="{Binding ProfileCard.IsOpen}" Background="#99000000">
            <Border Width="330"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Classes="sheet"
                    Padding="16">
                <StackPanel Spacing="13">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="46" Height="46" Margin="0,0,12,0"
                                CornerRadius="{StaticResource AuraRadiusAvatar}"
                                ClipToBounds="True"
                                Background="{DynamicResource AuraBrandGradientBrush}">
                            <Panel>
                                <TextBlock Text="{Binding ProfileCard.Initial}"
                                           IsVisible="{Binding ProfileCard.ShowInitial}"
                                           FontSize="{StaticResource AuraFont18}" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding ProfileCard.Avatar}"
                                       IsVisible="{Binding ProfileCard.HasAvatar}"
                                       Stretch="UniformToFill"/>
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding ProfileCard.Name}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource AuraTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Classes="badge" HorizontalAlignment="Left" BorderThickness="1"
                                    Background="{Binding ProfileCard.IsKeyChanged, Converter={x:Static converters:TrustRowBrushConverter.Fill}}"
                                    BorderBrush="{Binding ProfileCard.IsVerified, Converter={x:Static converters:VerifiedPillBorderConverter.Instance}}">
                                <TextBlock Classes="mono" Text="{Binding ProfileCard.TrustLabel}"
                                           FontSize="{StaticResource AuraMono9}"
                                           Foreground="{Binding ProfileCard.IsVerified, Converter={x:Static converters:VerifiedPillTextConverter.Instance}}"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="icon" Content="✕" VerticalAlignment="Top"
                                Command="{Binding ProfileCard.CloseCommand}"
                                ToolTip.Tip="Close (Esc)"/>
                    </Grid>

                    <SelectableTextBlock Classes="mono" Text="{Binding ProfileCard.FingerprintOrHint}"
                                         FontSize="{StaticResource AuraMono9}"
                                         Foreground="{DynamicResource AuraTextDimBrush}"
                                         TextWrapping="Wrap"/>

                    <!-- Someone else's comment, rendered -->
                    <controls:MarkdownView IsVisible="{Binding ProfileCard.HasBio}"
                                           Markdown="{Binding ProfileCard.Bio}"
                                           TextSize="{StaticResource AuraFont12}"
                                           TextBrush="{DynamicResource AuraTextMidBrush}"
                                           LinkBrush="{DynamicResource AuraLinkBrush}"
                                           AccentBrush="{DynamicResource AuraAccentBrush}"
                                           CodeBackground="{DynamicResource AuraWellBrush}"
                                           CodeFontFamily="{StaticResource AuraMonoFontFamily}"/>

                    <!-- Your own comment, editable -->
                    <StackPanel Spacing="{StaticResource AuraSpace5}" IsVisible="{Binding ProfileCard.IsSelf}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}">
                            <Button Content="Change avatar…"
                                    Command="{Binding ProfileCard.PickAvatarCommand}"
                                    CornerRadius="{StaticResource AuraRadiusControl}" Padding="10,5"
                                    FontSize="{StaticResource AuraFont12}"/>
                            <Button Content="Remove avatar"
                                    Command="{Binding ProfileCard.ClearAvatarCommand}"
                                    IsVisible="{Binding ProfileCard.CanRemoveAvatar}"
                                    CornerRadius="{StaticResource AuraRadiusControl}" Padding="10,5"
                                    FontSize="{StaticResource AuraFont12}"/>
                        </StackPanel>
                        <TextBlock Classes="monoLabel" Text="PRESENCE"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <!-- Stretched so it is exactly as tall as the status box -->
                            <ComboBox Grid.Column="0" Classes="aura" MinWidth="136"
                                      VerticalAlignment="Stretch"
                                      ItemsSource="{Binding PresenceOptions}"
                                      SelectedIndex="{Binding PresenceIndex}"/>
                            <TextBox Grid.Column="1" Classes="aura"
                                     Text="{Binding CustomStatus}"
                                     MaxLength="128"
                                     PlaceholderText="Custom status…"/>
                        </Grid>
                        <TextBlock Classes="monoLabel" Text="YOUR COMMENT · MARKDOWN"/>
                        <TextBox Classes="aura" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 Text="{Binding ProfileCard.BioDraft}"
                                 PlaceholderText="Say something about yourself…"/>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Classes="mono" Text="{Binding ProfileCard.BioCountLabel}"
                                       FontSize="{StaticResource AuraMono9}"
                                       Foreground="{DynamicResource AuraTextFaintBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ProfileCard.Status}"
                                       FontSize="{StaticResource AuraMono9}" Margin="8,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AuraAccentBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="Save" Classes="brand"
                                    Command="{Binding ProfileCard.SaveBioDraftCommand}"
                                    CornerRadius="{StaticResource AuraRadiusControl}" Padding="14,6"
                                    FontSize="{StaticResource AuraFont12}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{Binding ProfileCard.Error}"
                               IsVisible="{Binding ProfileCard.Error, Converter={StaticResource StringToBoolConverter}}"
                               FontSize="{StaticResource AuraFont11}"
                               Foreground="{DynamicResource AuraDangerBrush}" TextWrapping="Wrap"/>

                    <!-- Local volume + Compare keys -->
                    <StackPanel Spacing="{StaticResource AuraSpace8}" IsVisible="{Binding ProfileCard.CanAdjust}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="Local volume" FontSize="{StaticResource AuraFont12}"
                                       Foreground="{DynamicResource AuraTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding ProfileCard.LocalVolume}"
                                    IsSnapToTickEnabled="True" TickFrequency="5"/>
                            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding ProfileCard.LocalVolumeLabel}"
                                       FontSize="{StaticResource AuraMono10}" Margin="10,0,0,0"
                                       Foreground="{DynamicResource AuraTextDimBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}">
                            <Button Content="{Binding ProfileCard.LocalMuteLabel}"
                                    Command="{Binding ProfileCard.ToggleLocalMuteCommand}"
                                    CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                    FontSize="{StaticResource AuraFont12}"/>
                            <Button Content="Compare keys"
                                    Command="{Binding ProfileCard.CompareCommand}"
                                    IsEnabled="{Binding ProfileCard.CanCompareKeys}"
                                    CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                    FontSize="{StaticResource AuraFont12}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================================================================
             Channel editor (admin): create / edit / delete.
             ================================================================ -->
        <Border IsVisible="{Binding ChannelEditor.IsOpen}" Background="#99000000">
            <Border Width="400"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Classes="sheet"
                    Padding="18">
                <StackPanel Spacing="{StaticResource AuraSpace9}">
                    <TextBlock Classes="title" Text="{Binding ChannelEditor.Title}"/>
                    <Grid ColumnDefinitions="72,*">
                        <TextBox Grid.Column="0" Classes="aura" Margin="0,0,8,0"
                                 Text="{Binding ChannelEditor.Emoji}" PlaceholderText="🔊" MaxLength="8"/>
                        <TextBox Grid.Column="1" Classes="aura"
                                 Text="{Binding ChannelEditor.Name}" PlaceholderText="Channel name" MaxLength="64"/>
                    </Grid>
                    <TextBox Classes="aura" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                             Text="{Binding ChannelEditor.Comment}"
                             PlaceholderText="Comment / MOTD (markdown)"/>
                    <TextBlock Text="{Binding ChannelEditor.Error}"
                               IsVisible="{Binding ChannelEditor.Error, Converter={StaticResource StringToBoolConverter}}"
                               FontSize="{StaticResource AuraFont11}"
                               Foreground="{DynamicResource AuraDangerBrush}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4,0,0">
                        <Button Classes="danger" Grid.Column="0"
                                Content="{Binding ChannelEditor.DeleteLabel}"
                                Command="{Binding ChannelEditor.DeleteChannelCommand}"
                                IsVisible="{Binding !ChannelEditor.IsNew}"
                                Background="{DynamicResource AuraDangerFillBrush}"
                                Foreground="{DynamicResource AuraDangerBrush}"
                                BorderBrush="{DynamicResource AuraDangerBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="12,6"
                                FontSize="{StaticResource AuraFont12}"/>
                        <Button Grid.Column="2" Content="Cancel" Margin="0,0,8,0"
                                Command="{Binding ChannelEditor.CancelCommand}"
                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="14,6"
                                FontSize="{StaticResource AuraFont12}"/>
                        <Button Classes="brand" Grid.Column="3" Content="Save"
                                Command="{Binding ChannelEditor.SubmitCommand}"
                                IsEnabled="{Binding !ChannelEditor.IsBusy}"
                                Background="{DynamicResource AuraBrandGradientBrush}" Foreground="White"
                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="14,6"
                                FontSize="{StaticResource AuraFont12}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>


        <!-- ================================================================
             Leave server: destructive confirm.
             ================================================================ -->
        <Border IsVisible="{Binding ShowLeaveConfirm}" Background="#99000000">
            <Border Width="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Classes="sheet"
                    BorderBrush="{DynamicResource AuraDangerBorderBrush}"
                    Padding="18">
                <StackPanel Spacing="{StaticResource AuraSpace12}">
                    <TextBlock Classes="title" Text="{Binding LeaveConfirmTitle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LeaveConfirmBody}"
                               FontSize="{StaticResource AuraFont12}"
                               Foreground="{DynamicResource AuraTextMidBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelLeaveServerCommand}"
                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="14,6"
                                FontSize="{StaticResource AuraFont12}"/>
                        <Button Classes="dangerSolid" Content="Delete my account"
                                Command="{Binding ConfirmLeaveServerCommand}"
                                IsEnabled="{Binding !IsLeaving}"
                                Background="{DynamicResource AuraDangerBrush}" Foreground="White"
                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="14,6"
                                FontSize="{StaticResource AuraFont12}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================================================================
             Restore identity: confirm before replacing the identity file.
             ================================================================ -->
        <Border IsVisible="{Binding ShowRestoreConfirm}" Background="#99000000">
            <Border Width="440"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Classes="sheet"
                    BorderBrush="{DynamicResource AuraCautionBorderBrush}"
                    Padding="18">
                <StackPanel Spacing="{StaticResource AuraSpace12}">
                    <TextBlock Classes="title" Text="Replace this device's identity?"/>
                    <SelectableTextBlock Classes="mono" Text="{Binding RestoreCurrentLabel}"
                                         FontSize="{StaticResource AuraMono11}"
                                         Foreground="{DynamicResource AuraTextDimBrush}" TextWrapping="Wrap"/>
                    <SelectableTextBlock Classes="mono" Text="{Binding RestoreBackupLabel}"
                                         FontSize="{StaticResource AuraMono11}"
                                         Foreground="{DynamicResource AuraAccentBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="The current identity file is kept alongside, renamed. You'll be disconnected and can connect again with the restored key."
                               FontSize="{StaticResource AuraFont12}"
                               Foreground="{DynamicResource AuraTextMidBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelRestoreCommand}"
                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="14,6"
                                FontSize="{StaticResource AuraFont12}"/>
                        <Button Classes="caution" Content="Replace identity"
                                Command="{Binding ConfirmRestoreCommand}"
                                Background="{DynamicResource AuraCautionBrush}" Foreground="#12141A"
                                CornerRadius="{StaticResource AuraRadiusControl}" Padding="14,6"
                                FontSize="{StaticResource AuraFont12}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Panel>
</Window>
