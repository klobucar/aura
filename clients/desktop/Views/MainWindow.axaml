<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aura.Desktop.ViewModels"
        xmlns:converters="using:Aura.Desktop.Converters"
        xmlns:controls="using:Aura.Desktop.Controls"
        x:Class="Aura.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Aura"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur"
        Background="{DynamicResource AuraBackgroundBrush}">

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>

    <Window.KeyBindings>
        <!-- Mode swap: Ctrl+Alt+V (⌘⌥V on macOS) -->
        <KeyBinding Gesture="Ctrl+Alt+V" Command="{Binding ToggleLayoutModeCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- Window material. Acrylic carries the depth so the panes can be flat:
             one translucent layer per depth level, never glass on glass. The tint
             is set from the palette in code-behind. -->
        <ExperimentalAcrylicBorder x:Name="AcrylicRoot" IsHitTestVisible="False"/>

        <!-- ============================================================
             Three columns: roster 268 · chat flex · voice rail 336.
             In voice-focus the rail takes the slack and chat lands on 320;
             only VoiceColumnWidth animates (cubic ease-out 300ms).
             ============================================================ -->
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- ========================================================
                 ROSTER — identical in both modes. Every channel, expanded,
                 with its occupants, including channels you are not in.
                 ======================================================== -->
            <Border Grid.Column="0"
                    Width="{Binding RosterWidth}"
                    Background="{DynamicResource AuraSidebarOverlayBrush}"
                    BorderBrush="{DynamicResource AuraDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="10,0,10,12">

                    <!-- ── Title row ── -->
                    <Grid Grid.Row="0" Height="52" ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="☰"
                                   FontSize="{StaticResource AuraFont14}"
                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Aura"
                                   Classes="title"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ── Identity card ── -->
                    <Border Grid.Row="1" Classes="panel" Padding="12,10" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Rounded-square avatar (desktop idiom), brand gradient -->
                            <Border Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0"
                                    CornerRadius="{StaticResource AuraRadiusAvatar}"
                                    Background="{DynamicResource AuraBrandGradientBrush}">
                                <TextBlock Text="{Binding DisplayName[0], FallbackValue='?'}"
                                           FontSize="{StaticResource AuraFont14}"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="{StaticResource AuraFont13}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- `verified · 3f8a…5503` — mono is machine truth -->
                                <TextBlock Classes="mono"
                                           Text="{Binding FingerprintDisplay}"
                                           FontSize="{StaticResource AuraMono9}"
                                           Foreground="{DynamicResource AuraAccentBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Classes="icon"
                                    Command="{Binding DisconnectCommand}"
                                    IsVisible="{Binding IsConnected}"
                                    ToolTip.Tip="Disconnect">
                                <TextBlock Text="⏏" FontSize="{StaticResource AuraFont13}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── QUIC unavailable ──
                         Danger, not caution: this is not a risk to weigh, it is
                         the app being unable to run here. The remedy differs per
                         platform (a missing package on Linux, an OS floor on
                         Windows), so it is carried in the text rather than
                         implied. -->
                    <StackPanel Grid.Row="2">
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            CornerRadius="{StaticResource AuraRadiusTile}"
                            Background="{DynamicResource AuraDangerFillBrush}"
                            BorderBrush="{DynamicResource AuraDangerBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding ShowQuicUnavailable}">
                        <StackPanel Spacing="{StaticResource AuraSpace9}">
                            <TextBlock Text="{Binding QuicUnavailableHeadline}"
                                       FontSize="{StaticResource AuraFont13}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraDangerBrush}"
                                       TextWrapping="Wrap"/>
                            <SelectableTextBlock Text="{Binding QuicUnavailableRemedy}"
                                                 FontSize="{StaticResource AuraFont11}"
                                                 Foreground="{DynamicResource AuraTextDimBrush}"
                                                 TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Certificate warning (untrusted server key) ── -->
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            CornerRadius="{StaticResource AuraRadiusTile}"
                            Background="{DynamicResource AuraCautionFillBrush}"
                            BorderBrush="{DynamicResource AuraCautionBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding ShowingCertWarning}">
                        <StackPanel Spacing="{StaticResource AuraSpace9}">
                            <TextBlock Text="Untrusted certificate"
                                       FontSize="{StaticResource AuraFont13}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraCautionTextBrush}"/>
                            <TextBlock Text="The server is using an unknown identity. Check the fingerprint below:"
                                       FontSize="{StaticResource AuraFont11}"
                                       Foreground="{DynamicResource AuraTextDimBrush}"
                                       TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource AuraWellBrush}"
                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                    Padding="8">
                                <SelectableTextBlock Classes="mono"
                                                     Text="{Binding CertFingerprint}"
                                                     FontSize="{StaticResource AuraMono10}"
                                                     Foreground="{DynamicResource AuraTextMidBrush}"
                                                     TextWrapping="Wrap"/>
                            </Border>
                            <Button Command="{Binding TrustAndConnectCommand}"
                                    Background="{DynamicResource AuraCautionBrush}"
                                    Foreground="#12141A"
                                    FontWeight="SemiBold"
                                    FontSize="{StaticResource AuraFont12}"
                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                    Padding="0,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Content="They match — trust and connect"/>
                            <Button Command="{Binding DismissCertWarningCommand}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource AuraPanelBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource AuraTextBrush}"
                                    FontSize="{StaticResource AuraFont12}"
                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                    Padding="0,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Content="Cancel"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- ── Channels + occupants, or the connection form ── -->
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="{StaticResource AuraSpace8}">

                            <!-- Connection form (disconnected only) -->
                            <StackPanel Spacing="{StaticResource AuraSpace8}">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsConnected" Converter="{StaticResource InverseBoolConverter}"/>
                                        <Binding Path="ShowingCertWarning" Converter="{StaticResource InverseBoolConverter}"/>
                                    </MultiBinding>
                                </StackPanel.IsVisible>

                                <TextBlock Classes="monoLabel" Text="CONNECTION" Margin="8,6,0,2"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Classes="aura"
                                             Text="{Binding ServerAddress}"
                                             PlaceholderText="Server"/>
                                    <TextBox Grid.Column="1" Classes="aura"
                                             Text="{Binding ServerPort}"
                                             PlaceholderText="Port"
                                             Width="72" Margin="6,0,0,0"/>
                                </Grid>

                                <TextBox Classes="aura"
                                         Text="{Binding ServerPassword}"
                                         PlaceholderText="Password (optional)"
                                         PasswordChar="•"/>

                                <TextBox Classes="aura"
                                         Text="{Binding DisplayName}"
                                         PlaceholderText="Display Name"/>

                                <Button Command="{Binding ConnectCommand}"
                                        Background="{DynamicResource AuraBrandGradientBrush}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        FontSize="{StaticResource AuraFont13}"
                                        CornerRadius="{StaticResource AuraRadiusControl}"
                                        Padding="0,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Content="Connect"/>
                            </StackPanel>

                            <!-- `ROSTER · 7 ONLINE` -->
                            <TextBlock Classes="monoLabel"
                                       Text="{Binding RosterLabel}"
                                       Margin="8,6,0,2"
                                       IsVisible="{Binding IsConnected}"/>

                            <ItemsControl ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:Channel">
                                        <StackPanel Margin="0,0,0,2">

                                            <!-- Channel row. Current channel gets a 3px
                                                 accent bar + subtle fill, the Fluent
                                                 NavigationView idiom, not a tinted capsule. -->
                                            <Button Classes="row"
                                                    Padding="0"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).JoinChannelCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="3,Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="3"
                                                            CornerRadius="{StaticResource AuraRadiusBadge}"
                                                            Background="{DynamicResource AuraAccentBrush}"
                                                            Margin="0,2"
                                                            IsVisible="{Binding IsCurrent}"/>

                                                    <TextBlock Grid.Column="1" Text="🔊"
                                                               FontSize="{StaticResource AuraFont13}"
                                                               Opacity="0.7"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,8,0"/>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,7">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="{StaticResource AuraFont13}"
                                                                   FontWeight="{Binding IsCurrent, Converter={x:Static converters:CurrentChannelWeightConverter.Instance}}"
                                                                   Foreground="{DynamicResource AuraTextBrush}"/>
                                                        <TextBlock Text="{Binding Comment}"
                                                                   FontSize="{StaticResource AuraFont11}"
                                                                   Foreground="{DynamicResource AuraTextFaintBrush}"
                                                                   IsVisible="{Binding Comment, Converter={StaticResource StringToBoolConverter}}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Occupancy pill -->
                                                    <Border Grid.Column="3" Classes="badge"
                                                            Background="{DynamicResource AuraWellBrush}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"
                                                            IsVisible="{Binding HasOccupants}">
                                                        <TextBlock Classes="mono"
                                                                   Text="{Binding Users.Count}"
                                                                   FontSize="{StaticResource AuraMono9}"
                                                                   Foreground="{DynamicResource AuraTextDimBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <!-- Occupants. Always expanded — this is the
                                                 Mumble affordance and must not be traded away. -->
                                            <ItemsControl ItemsSource="{Binding Users}" Margin="0,0,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:User">
                                                        <Border CornerRadius="{StaticResource AuraRadiusControl}"
                                                                Margin="12,1,0,1"
                                                                Padding="8,3"
                                                                Background="{Binding IsSpeaking, Converter={x:Static converters:SpeakingRowBrushConverter.Instance}}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <!-- 20px rounded square, 4px radius -->
                                                                <Border Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0"
                                                                        CornerRadius="{StaticResource AuraRadiusAvatarSmall}"
                                                                        Background="{Binding IsSpeaking, Converter={x:Static converters:AvatarBrushConverter.Instance}}">
                                                                    <TextBlock Text="{Binding Name[0], FallbackValue='?'}"
                                                                               FontSize="{StaticResource AuraMono9}"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           FontSize="{StaticResource AuraFont12}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding IsSpeaking, Converter={StaticResource StatusToBrushConverter}}"/>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                            Spacing="{StaticResource AuraSpace5}"
                                                                            VerticalAlignment="Center">
                                                                    <!-- speaking dot -->
                                                                    <Ellipse Width="6" Height="6"
                                                                             Fill="{DynamicResource AuraAccentBrush}"
                                                                             IsVisible="{Binding IsSpeaking}"/>
                                                                    <!-- mic.slash.fill in warn -->
                                                                    <TextBlock Text="🎙"
                                                                               FontSize="{StaticResource AuraMono9}"
                                                                               Foreground="{DynamicResource AuraWarnBrush}"
                                                                               IsVisible="{Binding IsMuted}"/>
                                                                    <!-- key.fill in caution -->
                                                                    <TextBlock Text="🔑"
                                                                               FontSize="{StaticResource AuraMono9}"
                                                                               Foreground="{DynamicResource AuraCautionBrush}"
                                                                               IsVisible="{Binding NeedsKeyCheck}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Audio settings, behind the Settings button ── -->
                    <Border Grid.Row="4" Classes="panel"
                            Padding="12,10"
                            Margin="0,8,0,8"
                            IsVisible="{Binding ShowAudioSettings}">
                        <StackPanel Spacing="{StaticResource AuraSpace9}">
                            <TextBlock Classes="monoLabel" Text="PROCESSING"/>
                            <CheckBox IsChecked="{Binding RnnoiseEnabled}" Content="RNNoise suppression"
                                      Foreground="{DynamicResource AuraTextBrush}" FontSize="{StaticResource AuraFont12}"/>
                            <CheckBox IsChecked="{Binding AecEnabled}" Content="Echo cancellation"
                                      Foreground="{DynamicResource AuraTextBrush}" FontSize="{StaticResource AuraFont12}"/>
                            <CheckBox IsChecked="{Binding WebrtcNsEnabled}" Content="WebRTC noise suppression"
                                      Foreground="{DynamicResource AuraTextBrush}" FontSize="{StaticResource AuraFont12}"/>
                            <CheckBox IsChecked="{Binding AgcEnabled}" Content="Auto gain control"
                                      Foreground="{DynamicResource AuraTextBrush}" FontSize="{StaticResource AuraFont12}"/>

                            <Separator Background="{DynamicResource AuraDividerBrush}" Height="1" Margin="0,4"/>
                            <TextBlock Classes="monoLabel" Text="OUTPUT"/>
                            <StackPanel Spacing="{StaticResource AuraSpace3}">
                                <TextBlock Classes="mono"
                                           Text="{Binding MasterVolume, StringFormat='master {0}%'}"
                                           FontSize="{StaticResource AuraMono10}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                                <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume}"
                                        IsSnapToTickEnabled="True" TickFrequency="5"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource AuraDividerBrush}" Height="1" Margin="0,4"/>
                            <TextBlock Classes="monoLabel" Text="LATENCY"/>
                            <StackPanel Spacing="{StaticResource AuraSpace3}">
                                <TextBlock Classes="mono"
                                           Text="{Binding DredDuration, StringFormat='DRED {0}0 ms'}"
                                           FontSize="{StaticResource AuraMono10}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                                <Slider Minimum="0" Maximum="10" Value="{Binding DredDuration}"
                                        IsSnapToTickEnabled="True" TickFrequency="1"/>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource AuraSpace3}">
                                <TextBlock Classes="mono"
                                           Text="{Binding JitterBufferMs, StringFormat='jitter {0} ms'}"
                                           FontSize="{StaticResource AuraMono10}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                                <Slider Minimum="0" Maximum="100" Value="{Binding JitterBufferMs}"
                                        IsSnapToTickEnabled="True" TickFrequency="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Connection status + Settings, bottom-pinned ── -->
                    <StackPanel Grid.Row="5" Spacing="{StaticResource AuraSpace5}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace5}" Margin="8,0">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                            <TextBlock Classes="mono"
                                       Text="{Binding ConnectionStatus}"
                                       FontSize="{StaticResource AuraMono9}"
                                       Foreground="{DynamicResource AuraTextFaintBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="216"
                                       ToolTip.Tip="{Binding ConnectionStatus}"/>
                        </StackPanel>

                        <Button Classes="row"
                                Command="{Binding ToggleAudioSettingsCommand}"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}">
                                <TextBlock Text="⚙" FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                                <TextBlock Text="Settings" FontSize="{StaticResource AuraFont12}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================
                 CHAT — the work surface in chat-first mode.
                 ======================================================== -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

                <!-- ── Channel header ── -->
                <Border Grid.Row="0" Height="46"
                        Background="{DynamicResource AuraChromeOverlayBrush}"
                        BorderBrush="{DynamicResource AuraDividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="🔊"
                                   FontSize="{StaticResource AuraFont14}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock Grid.Column="1"
                                   Classes="title"
                                   Text="{Binding SelectedChannel.Name, FallbackValue='No channel'}"
                                   VerticalAlignment="Center"/>

                        <!-- `E2EE · epoch 14` -->
                        <Border Grid.Column="2" Classes="badge"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AuraAccentPillFillBrush}"
                                BorderBrush="{DynamicResource AuraAccentPillBorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding HasEpoch}">
                            <TextBlock Classes="mono"
                                       Text="{Binding EpochLabel}"
                                       FontSize="{StaticResource AuraMono10}"
                                       Foreground="{DynamicResource AuraAccentBrush}"/>
                        </Border>

                        <!-- `12 messages today` -->
                        <TextBlock Grid.Column="4" Classes="mono"
                                   Text="{Binding MessagesTodayLabel}"
                                   FontSize="{StaticResource AuraMono10}"
                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <!-- Mode toggle -->
                        <Button Grid.Column="5" Classes="icon"
                                Command="{Binding ToggleLayoutModeCommand}"
                                ToolTip.Tip="{Binding LayoutToggleTip}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding LayoutToggleGlyph}"
                                       FontSize="{StaticResource AuraFont14}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Messages ── -->
                <Panel Grid.Row="1">

                <!-- Empty state. The column is otherwise a full-height void with
                     the composer stranded at the bottom, and it is the first
                     thing every new user sees. -->
                <Border IsVisible="{Binding ShowChatEmptyState}"
                        Classes="panel"
                        Padding="20,16"
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="{StaticResource AuraSpace8}">
                        <TextBlock Text="No messages yet"
                                   FontSize="{StaticResource AuraFont13}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AuraTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Messages here are end-to-end encrypted. Your server relays ciphertext only."
                                   FontSize="{StaticResource AuraFont12}"
                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,20,20,8">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessage">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">

                                    <!-- Avatar beside the message. Collapses to 0 in
                                         voice-focus, where the narrow column drops
                                         avatars and indents the sender name instead. -->
                                    <Border Grid.Column="0" Height="34"
                                            Width="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MessageAvatarWidth}"
                                            Margin="0,0,11,0"
                                            VerticalAlignment="Top"
                                            CornerRadius="{StaticResource AuraRadiusAvatar}"
                                            Background="{DynamicResource AuraBrandGradientBrush}"
                                            IsVisible="{Binding System, Converter={StaticResource InverseBoolConverter}}">
                                        <TextBlock Text="{Binding Initial}"
                                                   FontSize="{StaticResource AuraFont13}"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="{Binding System, Converter={x:Static converters:BoolToAlignmentConverter.CenterIfSystem}}">
                                        <!-- name + timestamp on one baseline row -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{StaticResource AuraSpace8}"
                                                    Margin="2,0,0,3"
                                                    IsVisible="{Binding System, Converter={StaticResource InverseBoolConverter}}">
                                            <TextBlock Text="{Binding UserName}"
                                                       FontSize="{StaticResource AuraFont13}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AuraTextMidBrush}"/>
                                            <TextBlock Classes="mono"
                                                       Text="{Binding TimeLabel}"
                                                       FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraTextFaintBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Background="{Binding ., Converter={x:Static converters:ChatBubbleColorConverter.Instance}}"
                                                BorderBrush="{DynamicResource AuraPanelBorderBrush}"
                                                BorderThickness="{Binding System, Converter={x:Static converters:BoolToThicknessConverter.Instance}}"
                                                CornerRadius="{StaticResource AuraRadiusTile}"
                                                Padding="{Binding System, Converter={x:Static converters:SystemMessagePaddingConverter.Instance}}"
                                                MaxWidth="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ChatBubbleMaxWidth}"
                                                HorizontalAlignment="{Binding System, Converter={x:Static converters:BoolToAlignmentConverter.CenterIfSystem}}">
                                            <TextBlock Text="{Binding Content}"
                                                       Foreground="{Binding ., Converter={x:Static converters:ChatBubbleTextColorConverter.Instance}}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{StaticResource AuraFont13}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Panel>

                <!-- ── Composer ── -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource AuraDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <!-- No attach button yet: dropped media (§5) is separate work,
                         and the Avalonia mock's composer is field + send. -->
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Classes="aura"
                                 Text="{Binding MessageInput}"
                                 PlaceholderText="{Binding ComposerPlaceholder}"
                                 VerticalAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- Keycap hint, mono. Hidden in the narrow chat column. -->
                        <TextBlock Grid.Column="1" Classes="mono"
                                   Text="Ctrl↵"
                                   FontSize="{StaticResource AuraMono9}"
                                   Foreground="{DynamicResource AuraTextFaintBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   IsVisible="{Binding IsChatFirst}"/>

                        <Button Grid.Column="2"
                                Command="{Binding SendMessageCommand}"
                                Width="36" Height="36"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource AuraBrandGradientBrush}">
                            <TextBlock Text="➤" FontSize="{StaticResource AuraFont13}" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================
                 VOICE RAIL (§3) / STAGE (§4). Same components, two sizes.
                 Only this column's width animates.
                 ======================================================== -->
            <Border Grid.Column="2"
                    Classes="modeColumn"
                    Width="{Binding VoiceColumnWidth}"
                    Background="{DynamicResource AuraSidebarOverlayBrush}"
                    BorderBrush="{DynamicResource AuraDividerBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- ── Rail header: "Voice" + latency pill ── -->
                    <Border Grid.Row="0" Height="46"
                            Background="{DynamicResource AuraChromeOverlayBrush}"
                            BorderBrush="{DynamicResource AuraDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Voice"
                                       FontSize="{StaticResource AuraFont13}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraTextBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Hidden when alone: a round-trip to nobody is not
                                 a measurement. -->
                            <Border Grid.Column="1" Classes="badge"
                                    Background="{DynamicResource AuraWellBrush}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding VoiceRail.ShowLatency}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace5}">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{Binding LatencyBrush}"/>
                                    <TextBlock Classes="mono"
                                               Text="{Binding LatencyLabel}"
                                               FontSize="{StaticResource AuraMono10}"
                                               Foreground="{DynamicResource AuraTextDimBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="14,14,14,0">
                        <StackPanel Spacing="{StaticResource AuraSpace12}">

                            <!-- ============ a. Current speaker card ============ -->
                            <Border Classes="panel"
                                    Background="{DynamicResource AuraAccentTintBrush}"
                                    BorderBrush="{DynamicResource AuraAccentBorderBrush}"
                                    Padding="14"
                                    IsVisible="{Binding VoiceRail.CurrentSpeaker, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="{StaticResource AuraSpace11}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <!-- Avatar + pulsing ring -->
                                        <Panel Grid.Column="0"
                                               Width="{Binding HeroAvatarSize}"
                                               Height="{Binding HeroAvatarSize}"
                                               Margin="0,0,11,0">
                                            <Border Classes="pulseRing"
                                                    Margin="-5"
                                                    CornerRadius="{StaticResource AuraRadiusTile}"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource AuraAccentRingBrush}"
                                                    IsVisible="{Binding VoiceRail.CurrentSpeaker.IsLive}"/>
                                            <Border CornerRadius="{StaticResource AuraRadiusAvatar}"
                                                    Background="{Binding VoiceRail.CurrentSpeaker.AvatarBrush}">
                                                <TextBlock Text="{Binding VoiceRail.CurrentSpeaker.Initial}"
                                                           FontSize="{StaticResource AuraFont18}"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Panel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Spacing="{StaticResource AuraSpace3}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}">
                                                <TextBlock Text="{Binding VoiceRail.CurrentSpeaker.Name}"
                                                           FontSize="{Binding HeroNameFontSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AuraTextBrush}"/>
                                                <Border Classes="badge"
                                                        Background="{DynamicResource AuraAccentPillFillBrush}"
                                                        BorderBrush="{DynamicResource AuraAccentPillBorderBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding VoiceRail.CurrentSpeaker.IsVerified}">
                                                    <TextBlock Classes="mono" Text="verified"
                                                               FontSize="{StaticResource AuraMono9}"
                                                               Foreground="{DynamicResource AuraAccentBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- `speaking 0:12 · 41%` -->
                                            <TextBlock Classes="mono"
                                                       Text="{Binding VoiceRail.CurrentSpeaker.SubLine}"
                                                       FontSize="{StaticResource AuraMono10}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live waveform -->
                                    <controls:BarMeter Mode="Waveform"
                                                       Levels="{Binding VoiceRail.WaveformLevels}"
                                                       BarCount="{Binding WaveformBarCount}"
                                                       Height="{Binding WaveformHeight}"
                                                       BarGap="2" BarRadius="2"
                                                       BarBrush="{DynamicResource AuraAccentBrush}"
                                                       DimBarBrush="{DynamicResource AuraAccentSoftBrush}"/>

                                    <!-- This speaker's local playback gain — NOT master
                                         output. Hidden for the local user, who cannot
                                         hear themselves. -->
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          IsVisible="{Binding VoiceRail.CurrentSpeaker.CanAdjustVolume, FallbackValue=False}">
                                        <TextBlock Grid.Column="0" Text="🔊"
                                                   FontSize="{StaticResource AuraFont12}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                Value="{Binding VoiceRail.CurrentSpeaker.LocalVolume}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Classes="mono"
                                                   Text="{Binding VoiceRail.CurrentSpeaker.LocalVolume}"
                                                   FontSize="{StaticResource AuraMono10}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Empty state: a chip, never a spinner -->
                            <Border Classes="panel"
                                    Padding="14,12"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding VoiceRail.ShowEmptyState}">
                                <TextBlock Text="{Binding VoiceRail.EmptyStateText}"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                            </Border>

                            <!-- ============ b. LAST 3 MIN lanes ============
                                 Lanes are a comparison between people. Alone
                                 they showed one lane at "61%" of nothing, under
                                 a legend for overlaps that cannot happen. -->
                            <Border Classes="panel" Padding="14,13"
                                    IsVisible="{Binding VoiceRail.ShowLanes}">
                                <StackPanel Spacing="{StaticResource AuraSpace9}">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="monoLabel" Text="LAST 3 MIN"/>
                                        <!-- legend: overlap == talked over -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="{StaticResource AuraSpace5}">
                                            <Border Width="7" Height="7"
                                                    CornerRadius="1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AuraCautionBrush}"/>
                                            <TextBlock Classes="mono" Text="overlap"
                                                       FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding VoiceRail.Lanes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TalkLaneViewModel">
                                                <Grid ColumnDefinitions="16,Auto,*,30"
                                                      Margin="0,0,0,5"
                                                      Opacity="{Binding LaneOpacity}">
                                                    <Border Grid.Column="0" Width="16" Height="16"
                                                            CornerRadius="{StaticResource AuraRadiusAvatarSmall}"
                                                            Background="{Binding AvatarBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontSize="8"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Name column: voice-focus only, fades in -->
                                                    <TextBlock Grid.Column="1"
                                                               Classes="modeFade"
                                                               Text="{Binding Name}"
                                                               FontSize="{StaticResource AuraFont12}"
                                                               Foreground="{DynamicResource AuraTextMidBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"
                                                               Width="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LaneNameColumnWidth}"
                                                               Opacity="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ModeExtrasOpacity}"/>

                                                    <controls:TalkLane Grid.Column="2"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Height="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LaneHeight}"
                                                                       SegmentHeight="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LaneSegmentHeight}"
                                                                       SegmentRadius="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LaneSegmentRadius}"
                                                                       Segments="{Binding Segments}"
                                                                       Overlaps="{Binding Overlaps}"
                                                                       SegmentBrush="{Binding SegmentBrush}"
                                                                       LiveSegmentBrush="{DynamicResource AuraSegmentLiveBrush}"
                                                                       OverlapBrush="{DynamicResource AuraOverlapBrush}"
                                                                       TrackBrush="{DynamicResource AuraTrackBrush}"
                                                                       TrackBorderBrush="{DynamicResource AuraTrackBorderBrush}"/>

                                                    <TextBlock Grid.Column="3" Classes="mono"
                                                               Text="{Binding ShareLabel}"
                                                               FontSize="{StaticResource AuraMono9}"
                                                               Foreground="{DynamicResource AuraTextDimBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Lane overflow: top 5 + "N others", expandable -->
                                    <Button Classes="row"
                                            Padding="0,4"
                                            Command="{Binding VoiceRail.ToggleOverflowCommand}"
                                            IsVisible="{Binding VoiceRail.HasOverflow}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace8}"
                                                    Margin="24,0,0,0">
                                            <TextBlock Classes="mono"
                                                       Text="{Binding VoiceRail.OverflowLabel}"
                                                       FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                                            <TextBlock Text="▾" FontSize="{StaticResource AuraMono9}"
                                                       Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Time axis: stage only, fades across the swap -->
                                    <Grid Classes="modeFade"
                                          ColumnDefinitions="*,*,*,Auto"
                                          Margin="86,0,0,0"
                                          Height="{Binding TimeAxisHeight}"
                                          Opacity="{Binding ModeExtrasOpacity}">
                                        <TextBlock Grid.Column="0" Classes="mono" Text="−3 min"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                        <TextBlock Grid.Column="1" Classes="mono" Text="−2 min"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                        <TextBlock Grid.Column="2" Classes="mono" Text="−1 min"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                        <TextBlock Grid.Column="3" Classes="mono" Text="now"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============ c. SILENT ============ -->
                            <StackPanel Spacing="{StaticResource AuraSpace8}"
                                        IsVisible="{Binding VoiceRail.ShowSilent}">
                                <TextBlock Classes="monoLabel" Text="SILENT"/>
                                <ItemsControl ItemsSource="{Binding VoiceRail.SilentMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SilentMemberViewModel">
                                            <Border CornerRadius="{StaticResource AuraRadiusTile}"
                                                    Padding="12,8"
                                                    Margin="0,0,0,5"
                                                    Background="{Binding NeedsTrust, Converter={x:Static converters:TrustRowBrushConverter.Fill}}"
                                                    BorderBrush="{Binding NeedsTrust, Converter={x:Static converters:TrustRowBrushConverter.Border}}"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="22" Height="22"
                                                            Margin="0,0,10,0"
                                                            CornerRadius="{StaticResource AuraRadiusAvatarSmall}"
                                                            Background="{Binding AvatarBrush}">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontSize="{StaticResource AuraMono9}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               FontSize="{StaticResource AuraFont12}"
                                                               Foreground="{DynamicResource AuraTextMidBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2" Classes="mono"
                                                               Text="{Binding StateLabel}"
                                                               FontSize="{StaticResource AuraMono9}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding NeedsTrust, Converter={x:Static converters:TrustRowBrushConverter.Text}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ d. Command HUD ============
                         Docked CommandBar at the pane bottom — the desktop
                         translation of the floating macOS capsule. -->
                    <CommandBar Grid.Row="2"
                                Background="{DynamicResource AuraChromeOverlayBrush}"
                                BorderBrush="{DynamicResource AuraDividerBrush}"
                                BorderThickness="0,1,0,0"
                                IsEnabled="{Binding IsAuthenticated}">
                        <CommandBar.Content>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                                  Margin="14,10"
                                  VerticalAlignment="Center">

                                <!-- Mic / deafen segmented pair in a well -->
                                <Border Grid.Column="0" Classes="well" Padding="3">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <ToggleButton IsChecked="{Binding IsMicEnabled}"
                                                      Command="{Binding ToggleMicrophoneCommand}"
                                                      Classes="hudSegment"
                                                      ToolTip.Tip="Microphone">
                                            <TextBlock Text="{Binding IsMicEnabled, Converter={x:Static converters:MicIconConverter.Instance}}"
                                                       FontSize="{StaticResource AuraFont13}"/>
                                        </ToggleButton>
                                        <ToggleButton IsChecked="{Binding IsDeafened}"
                                                      Command="{Binding ToggleDeafenCommand}"
                                                      Classes="hudSegment"
                                                      ToolTip.Tip="Deafen">
                                            <TextBlock Text="{Binding IsDeafened, Converter={x:Static converters:DeafenIconConverter.Instance}}"
                                                       FontSize="{StaticResource AuraFont13}"/>
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>

                                <!-- Input meter -->
                                <StackPanel Grid.Column="1" Spacing="{StaticResource AuraSpace3}"
                                            Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="monoLabel" Text="INPUT"/>
                                        <TextBlock Grid.Column="2" Classes="mono"
                                                   Text="{Binding VoiceRail.InputDbLabel}"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                    <controls:BarMeter Mode="Level"
                                                       Level="{Binding VoiceRail.InputLevel}"
                                                       BarCount="9" BarGap="2" BarRadius="1"
                                                       Width="72" Height="14"
                                                       BarBrush="{DynamicResource AuraAccentBrush}"
                                                       DimBarBrush="{DynamicResource AuraTrackBrush}"/>
                                </StackPanel>

                                <!-- PTT chip: `PTT · Ctrl+Space`, `held 0:04` while down -->
                                <Border Grid.Column="2" Classes="well"
                                        Padding="10,6" Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AuraSpace5}">
                                        <TextBlock Classes="mono" Text="PTT ·"
                                                   FontSize="{StaticResource AuraMono10}"
                                                   Foreground="{DynamicResource AuraTextDimBrush}"/>
                                        <TextBlock Classes="mono" Text="Ctrl+Space"
                                                   FontSize="{StaticResource AuraMono10}"
                                                   Foreground="{DynamicResource AuraAccentBrush}"/>
                                        <TextBlock Classes="mono"
                                                   Text="{Binding PttHeldLabel}"
                                                   FontSize="{StaticResource AuraMono9}"
                                                   Foreground="{DynamicResource AuraTextFaintBrush}"
                                                   IsVisible="{Binding IsPushToTalkHeld}"/>
                                    </StackPanel>
                                </Border>

                                <!-- RNNoise: ToggleSwitch, the Fluent idiom. Stage only —
                                     the 336px rail has no room for it. -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            Spacing="{StaticResource AuraSpace8}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsVoiceFocus}">
                                    <TextBlock Text="RNNoise"
                                               FontSize="{StaticResource AuraFont12}"
                                               Foreground="{DynamicResource AuraTextDimBrush}"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch IsChecked="{Binding RnnoiseEnabled}"
                                                  OnContent="" OffContent=""
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </CommandBar.Content>
                    </CommandBar>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================
             Trust sheet (§7) — makes E2EE legible.

             A sheet over the channel rather than a separate window: the room
             stays visible behind it, which is the point of the material. The
             scrim also swallows clicks, so the sheet is modal without a dialog.
             ================================================================ -->
        <Border IsVisible="{Binding TrustSheet.IsOpen}"
                Background="#99000000">
            <Border Width="560"
                    MaxHeight="720"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AuraPanelFillBrush}"
                    BorderBrush="{DynamicResource AuraPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AuraRadiusTile}"
                    Padding="{StaticResource AuraSpace18}">
                <DockPanel LastChildFill="True">

                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource AuraSpace3}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="CHANNEL SECURITY"
                                       Classes="monoLabel"
                                       Foreground="{DynamicResource AuraTextDimBrush}"/>
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Command="{Binding TrustSheet.CloseCommand}"
                                    Content="✕"
                                    ToolTip.Tip="Close"/>
                        </Grid>

                        <TextBlock FontSize="{StaticResource AuraFont14}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AuraTextBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{Binding TrustSheet.ChannelName, Mode=OneWay}"/><Run Text=" is end-to-end encrypted"/>
                        </TextBlock>

                        <TextBlock Text="{Binding TrustSheet.SecurityLine}"
                                   Classes="mono"
                                   FontSize="{StaticResource AuraMono11}"
                                   Foreground="{DynamicResource AuraTextDimBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Your server relays ciphertext only."
                                   FontSize="{StaticResource AuraFont12}"
                                   Foreground="{DynamicResource AuraTextFaintBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- Something went wrong reading the group. -->
                        <Border IsVisible="{Binding TrustSheet.HasError}"
                                Background="{DynamicResource AuraDangerFillBrush}"
                                BorderBrush="{DynamicResource AuraDangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="{StaticResource AuraSpace11}"
                                Margin="0,8,0,0">
                            <TextBlock Text="{Binding TrustSheet.Error}"
                                       FontSize="{StaticResource AuraFont12}"
                                       Foreground="{DynamicResource AuraTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Key-changed banner. Amber, not red: a reinstall and a
                             takeover look identical from here, so it warns rather
                             than accuses. -->
                        <Border IsVisible="{Binding TrustSheet.ShowKeyChangedBanner}"
                                Background="{DynamicResource AuraCautionFillBrush}"
                                BorderBrush="{DynamicResource AuraCautionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="{StaticResource AuraSpace11}"
                                Margin="0,10,0,0">
                            <StackPanel Spacing="{StaticResource AuraSpace3}">
                                <TextBlock Text="{Binding TrustSheet.KeyChangedTitle}"
                                           FontSize="{StaticResource AuraFont13}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraCautionTextBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TrustSheet.KeyChangedBody}"
                                           FontSize="{StaticResource AuraFont12}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actions, pinned to the bottom so they stay reachable
                         however long the member list gets. -->
                    <Grid DockPanel.Dock="Bottom"
                          ColumnDefinitions="*,Auto"
                          Margin="0,14,0,0"
                          IsVisible="{Binding TrustSheet.CanAct}">
                        <Button Grid.Column="0"
                                Command="{Binding TrustSheet.MarkVerifiedCommand}"
                                Background="{DynamicResource AuraBrandGradientBrush}"
                                Foreground="White"
                                FontSize="{StaticResource AuraFont13}"
                                FontWeight="SemiBold"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="14,9"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Content="They match — mark verified"/>
                        <Button Grid.Column="1"
                                Command="{Binding TrustSheet.BlockCommand}"
                                Background="{DynamicResource AuraDangerFillBrush}"
                                BorderBrush="{DynamicResource AuraDangerBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource AuraDangerBrush}"
                                FontSize="{StaticResource AuraFont13}"
                                FontWeight="SemiBold"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="14,9"
                                Margin="8,0,0,0"
                                Content="Block"/>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="{StaticResource AuraSpace14}" Margin="0,14,0,0">

                            <!-- Safety words -->
                            <StackPanel Spacing="{StaticResource AuraSpace8}"
                                        IsVisible="{Binding TrustSheet.PairLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding TrustSheet.PairLabel}"
                                           Classes="monoLabel"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>

                                <ItemsControl ItemsSource="{Binding TrustSheet.SafetyWords}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AuraWellBrush}"
                                                    BorderBrush="{DynamicResource AuraTrackBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                                    Padding="10,8"
                                                    Margin="0,0,6,6">
                                                <!-- Selectable: users paste these into
                                                     whatever out-of-band channel they trust. -->
                                                <SelectableTextBlock Text="{Binding}"
                                                                     Classes="mono"
                                                                     FontSize="{StaticResource AuraMono13}"
                                                                     Foreground="{DynamicResource AuraTextBrush}"
                                                                     HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Deriving takes an scrypt run; a chip, never a spinner. -->
                            <Border IsVisible="{Binding TrustSheet.IsDeriving}"
                                    Background="{DynamicResource AuraWellBrush}"
                                    CornerRadius="{StaticResource AuraRadiusControl}"
                                    Padding="12,9"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="deriving safety words…"
                                           Classes="mono"
                                           FontSize="{StaticResource AuraMono11}"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>
                            </Border>

                            <!-- The full fingerprint pair: the authoritative
                                 comparison the words are a convenience over. -->
                            <StackPanel Spacing="{StaticResource AuraSpace5}"
                                        IsVisible="{Binding TrustSheet.RemoteFingerprint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <SelectableTextBlock Text="{Binding TrustSheet.RemoteFingerprint}"
                                                     Classes="mono"
                                                     FontSize="{StaticResource AuraMono11}"
                                                     Foreground="{DynamicResource AuraTextMidBrush}"
                                                     TextWrapping="Wrap"/>
                                <SelectableTextBlock Text="{Binding TrustSheet.LocalFingerprint}"
                                                     Classes="mono"
                                                     FontSize="{StaticResource AuraMono11}"
                                                     Foreground="{DynamicResource AuraTextDimBrush}"
                                                     TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Members -->
                            <StackPanel Spacing="{StaticResource AuraSpace5}">
                                <TextBlock Text="MEMBERS"
                                           Classes="monoLabel"
                                           Foreground="{DynamicResource AuraTextDimBrush}"/>

                                <ItemsControl ItemsSource="{Binding TrustSheet.Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TrustMemberViewModel">
                                            <Button Classes="row"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding $parent[ItemsControl].((vm:TrustSheetViewModel)DataContext).SelectCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0"
                                                            Width="3" Height="18"
                                                            CornerRadius="2"
                                                            Margin="0,0,9,0"
                                                            Background="{DynamicResource AuraAccentBrush}"
                                                            IsVisible="{Binding IsSelected}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="{StaticResource AuraFont13}"
                                                               Foreground="{DynamicResource AuraTextBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding StateLabel}"
                                                               Classes="mono"
                                                               FontSize="{StaticResource AuraMono10}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</Window>
