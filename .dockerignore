# Send only the Dockerfile and Cargo workspace files used by the server build.
**
!Dockerfile
!.dockerignore
!Cargo.toml
!Cargo.lock
!crates/*/Cargo.toml
!crates/*/build.rs
!crates/*/src/**

# Keep local state and credentials out of the allowed source directories.
**/.git
**/.claude
**/.codex
**/.DS_Store
**/.env
**/.env.*
**/target
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.pem
**/*.crt
**/*.key
**/*.log
**/*.rs.bk

# Local server diagnostic, ignored by Git as well.
crates/aura-server/src/bin/ping.rs
